<Window x:Class="Lertaro.App.Views.QuickLook.QuickLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickLook"
        Height="529" Width="400"
        MinHeight="300" MinWidth="300"
        WindowStyle="None"
        Background="{DynamicResource ContentBg}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="CanResizeWithGrip"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        BorderThickness="0">

    <!-- The window is opaque, which is what lets its text be antialiased sub-pixel; the chrome is what
         keeps an opaque borderless window behaving, with a resize border of 0 rather than the band that used
         to cover the 6px overlay scrollbar along its edges. The bottom-right grip is the only thing that
         resizes it; see ResizeGrip.xaml. CaptionHeight is 0 deliberately: this window drags from its own
         header and footer handlers, so the chrome must not claim a caption area of its own. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <!-- The card reaches the window's own edge now, so the grip's lines only need to clear the
                 card's 1.5 DIP border to stay inside it. -->
            <Thickness x:Key="ResizeGripInset">4,4,2,2</Thickness>
        </ResourceDictionary>
    </Window.Resources>
    
    <!-- The card IS the window: the 12 DIP margin it carried was a transparent halo holding the drop
         shadow the layered window painted around itself, and an opaque window has no pixels out there to
         paint into. The CornerRadius stays: the window manager rounds the real window on Windows 11, and
         this radius is what rounds the card anywhere it cannot. -->
    <Border x:Name="WindowBorder" CornerRadius="{StaticResource CornerRadiusWindow}" BorderThickness="1.5"
            Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: Icon, Name, Folder. The whole row is the drag handle for the previewed file (see
                 QuickLookWindow.xaml.cs). Background is set explicitly because an unpainted Panel is
                 only hit-testable over its children, so the empty space beside a short filename would
                 otherwise not start a drag. -->
            <Grid x:Name="HeaderDragHandle" Grid.Row="0" Margin="0,0,0,12" Background="Transparent" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="ImgFileIcon" Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFileName" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtFilePath" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- Affordance only; the drag target is the whole row above, not just these bars. -->
                <TextBlock x:Name="TxtDragGrip" Grid.Column="2" Text="&#xE76F;" FontFamily="{DynamicResource AppIconFontFamily}"
                           FontSize="14" Foreground="{DynamicResource TextSecondary}" Opacity="0.5"
                           VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <!-- Separator -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,0"/>

            <!-- Content Panel: ContentBg, a shade back from the outer CardBackground chrome, matching
                 the same recessed-content convention SearchWindow/QuickSearchWindow use for their own
                 results area, instead of this preview panel sitting flush with the card's own tone. -->
            <Grid Grid.Row="1" Margin="0,12,0,12" Background="{DynamicResource ContentBg}">
                <ContentControl x:Name="ContentArea" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>

            <!-- Footer: Size and Dates -->
            <Grid x:Name="FooterGrid" Grid.Row="2" Margin="0,8,0,0" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Background="{DynamicResource SeparatorBrush}" Margin="0,-8,0,8"/>
                <TextBlock x:Name="TxtFooterSize" Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock x:Name="TxtFooterDate" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
