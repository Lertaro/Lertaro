<UserControl x:Class="Lertaro.App.Views.Settings.PathEntryEditor"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="3.5*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Margin="0,0,8,0"
                 Text="{Binding EntryName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Grid.Column="1" Margin="8,0,8,0"
                 Text="{Binding EntryPath, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Content="&#xED25;" Style="{StaticResource RuleIconButton}" Width="30" Height="30" Margin="0,0,4,0"
                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_BrowseFolderTooltip]}"
                    Command="{Binding BrowseFolderCommand, ElementName=Root}"
                    CommandParameter="{Binding DataContext, ElementName=Root}"/>
            <Button Content="&#xE8A5;" Style="{StaticResource RuleIconButton}" Width="30" Height="30"
                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_BrowseFileTooltip]}"
                    Command="{Binding BrowseFileCommand, ElementName=Root}"
                    CommandParameter="{Binding DataContext, ElementName=Root}"/>
        </StackPanel>
    </Grid>
</UserControl>
