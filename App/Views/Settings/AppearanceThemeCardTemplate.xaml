<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared by every preview card below (theme cards and the three mode cards): the shadow
         lives on this unclipped wrapper, never on the same Border that also clips its rounded
         content. Putting a blurred Effect on a ClipToBounds="True" element let the blur's own
         silhouette poke out past the clip as a stray rounded shape at one corner, especially
         with cards packed this close together. Callers set Width/Height/CornerRadius per card
         and nest their own clipped, colored Border inside this one. -->
    <Style x:Key="PreviewCardShadowWrapperStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Opacity="0.18" Color="{DynamicResource ShadowColor}"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mimics QuickSearchWindow: the floating search box and result list the user actually
         sees dozens of times a day, rather than the settings window this page lives in.
         Everything below is inset from the outer rounded edge with margin (never flush against
         it), so nothing needs corner-radius matching against CardBorder's own rounding. -->
    <DataTemplate x:Key="ThemeCardTemplate">
        <StackPanel Margin="0,0,12,16" Cursor="Hand">
            <Border Width="148" Height="96" Style="{StaticResource PreviewCardShadowWrapperStyle}">
                <Border x:Name="CardBorder" CornerRadius="12"
                        Background="{Binding CardBg}" BorderThickness="1.5"
                        BorderBrush="{Binding CardBorder}" ClipToBounds="True">
                    <StackPanel Margin="8">
                        <!-- Search box: the real quick-search bar's own status icon is a
                             monochrome logo (tray.png) tinted via OpacityMask, docked to the
                             right by default. Reused here instead of a generic magnifier glyph,
                             in the same spot, so this reads as "this app" not just "a search
                             box". -->
                        <Border Height="20" CornerRadius="6" Background="{Binding SearchBg}">
                            <Grid Margin="6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Height="5" Width="40" RadiusX="2.5" RadiusY="2.5" Opacity="0.4"
                                           Fill="{Binding TextSecondary}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Width="10" Height="10" Margin="6,0,0,0"
                                        Background="{Binding TextSecondary}" VerticalAlignment="Center">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Lertaro.App;component/tray.png"/>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Two mock result rows, the second shown selected -->
                        <Grid Height="16" Margin="2,8,2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Text}" Opacity="0.3" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Height="6" Width="46" RadiusX="3" RadiusY="3" Opacity="0.5"
                                       Fill="{Binding Text}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                        <Border Height="18" CornerRadius="5" Background="{Binding SelectedRowBg}" Margin="2,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="{Binding AccentBar}"/>
                                <Rectangle Grid.Column="1" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Accent}"
                                           VerticalAlignment="Center" Margin="7,0,0,0"/>
                                <Rectangle Grid.Column="2" Height="6" Width="54" RadiusX="3" RadiusY="3" Opacity="0.85"
                                           Fill="{Binding Text}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
            <Grid Margin="2,8,0,0">
                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                <Border x:Name="SelectedBadge" Width="14" Height="14" CornerRadius="7"
                        Background="{Binding Accent}" HorizontalAlignment="Right" Visibility="Collapsed">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="7"
                               Foreground="{Binding AccentText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{Binding Accent}"/>
                <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
