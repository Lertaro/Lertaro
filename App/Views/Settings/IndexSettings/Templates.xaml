<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:Lertaro.App.Services">
    <!-- StaticResource inside a DataTemplate resolves against the scope where the template was
         declared, not wherever it's later instantiated. So every key these templates reference
         (BoolToVis from Styles.xaml here, RuleIconButtonAccent/SettingsRow/SettingsButton/
         SettingsComboBox from the app-level dictionaries) has to be merged in directly, not just by
         whichever tab UserControl ends up hosting the ItemsControl that uses this template. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
        <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
        <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
        <ResourceDictionary Source="Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="RuleItemTemplate">
        <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                           Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE70F;"
                            ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_EditTooltip]}"
                            Style="{StaticResource RuleIconButtonAccent}"
                            Command="{Binding DataContext.Exclusions.EditPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="&#xE74D;"
                            ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RemoveTooltip]}"
                            Style="{StaticResource RuleIconButtonAccent}"
                            Command="{Binding DataContext.Exclusions.RemovePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="GlobItemTemplate">
        <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                           Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE70F;"
                            ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_EditTooltip]}"
                            Style="{StaticResource RuleIconButtonAccent}"
                            Command="{Binding DataContext.Exclusions.EditGlobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="&#xE74D;"
                            ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RemoveTooltip]}"
                            Style="{StaticResource RuleIconButtonAccent}"
                            Command="{Binding DataContext.Exclusions.RemoveGlobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="RegexItemTemplate">
        <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                           Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE70F;"
                            ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_EditTooltip]}"
                            Style="{StaticResource RuleIconButtonAccent}"
                            Command="{Binding DataContext.Exclusions.EditRegexCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="&#xE74D;"
                            ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RemoveTooltip]}"
                            Style="{StaticResource RuleIconButtonAccent}"
                            Command="{Binding DataContext.Exclusions.RemoveRegexCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="LocalDriveTemplate">
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/><ColumnDefinition Width="70"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEditEnabled}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding State}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                <Button Grid.Column="5"
                        Style="{StaticResource SettingsButton}"
                        MinWidth="72"
                        Height="28"
                        Padding="10,0"
                        Content="{Binding RowActionText}"
                        Command="{Binding RowActionCommand}"
                        IsEnabled="{Binding CanRunRowAction}"
                        Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="NetworkDriveTemplate">
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*" MinWidth="126"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditEnabled}"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Drive, StringFormat={}{0}:}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="4"
                          Width="116"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Style="{StaticResource SettingsComboBox}"
                          ItemsSource="{Binding DataContext.NetworkDrive.RefreshModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding RefreshMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanEditRefreshMode}"/>
                <Button Grid.Column="5"
                        Style="{StaticResource SettingsButton}"
                        MinWidth="72"
                        Height="28"
                        Padding="10,0"
                        Content="{Binding RowActionText}"
                        Command="{Binding RowActionCommand}"
                        IsEnabled="{Binding CanRunRowAction}"
                        Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="WslDriveTemplate">
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*" MinWidth="126"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditEnabled}"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DistroName}" FontSize="13" VerticalAlignment="Center" ToolTip="{Binding UncPath}"/>
                <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="4"
                          Width="116"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Style="{StaticResource SettingsComboBox}"
                          ItemsSource="{Binding DataContext.NetworkDrive.RefreshModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding RefreshMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanEditRefreshMode}"/>
                <Button Grid.Column="5"
                        Style="{StaticResource SettingsButton}"
                        MinWidth="72"
                        Height="28"
                        Padding="10,0"
                        Content="{Binding RowActionText}"
                        Command="{Binding RowActionCommand}"
                        IsEnabled="{Binding CanRunRowAction}"
                        Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="FolderIndexTemplate">
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*" MinWidth="126"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditEnabled}"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="4"
                          Width="116"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Style="{StaticResource SettingsComboBox}"
                          ItemsSource="{Binding DataContext.NetworkDrive.RefreshModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding RefreshMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanEditRefreshMode}"/>
                <Button Grid.Column="5"
                        Style="{StaticResource SettingsButton}"
                        MinWidth="72"
                        Height="28"
                        Padding="10,0"
                        Content="{Binding RowActionText}"
                        Command="{Binding RowActionCommand}"
                        IsEnabled="{Binding CanRunRowAction}"
                        Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
