<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:Lertaro.App.Services">
    <!-- StaticResource inside a DataTemplate resolves against the scope where the template was
         declared, not wherever it's later instantiated. So every key these templates reference
         (BoolToVis from Styles.xaml here, RuleIconButtonAccent/SettingsRow/SettingsButton/
         SettingsComboBox from the app-level dictionaries) has to be merged in directly, not just by
         whichever tab UserControl ends up hosting the ItemsControl that uses this template. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
        <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
        <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
        <ResourceDictionary Source="Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="IndexRuleItemTemplate">
        <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
            <Grid>
                <!-- Display row -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="14" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE8A5;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Path">
                                        <Setter Property="Text" Value="&#xE8B7;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding EffectText}" FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EffectValue}" Value="Exclude">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EffectValue}" Value="High">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EffectValue}" Value="Low">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary2}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="13" Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Only a high rule can pin, so the box appears and disappears with the level. -->
                        <CheckBox IsChecked="{Binding AlwaysTop, Mode=TwoWay}" IsEnabled="{Binding CanPin}"
                                  Visibility="{Binding CanPin, Converter={StaticResource BoolToVis}}"
                                  VerticalAlignment="Center" Margin="0,0,6,0"
                                  ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_AlwaysTopTooltip]}">
                            <CheckBox.Content>
                                <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13" Text="&#xE718;"/>
                            </CheckBox.Content>
                        </CheckBox>
                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,4,0"
                                   ToolTip="{Binding ConflictTooltip}" Visibility="{Binding IsConflict, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="&#xE70F;" ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_EditTooltip]}" Style="{StaticResource RuleIconButtonAccent}" Command="{Binding DataContext.Exclusions.EditRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <Button Content="&#xE74D;" ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RemoveTooltip]}" Style="{StaticResource RuleIconButtonAccent}" Command="{Binding DataContext.Exclusions.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>

                <!-- Edit row: text plus the effect dropdown, so moving a rule between levels needs no drag. -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="&#xE8B7;" FontFamily="{DynamicResource AppIconFontFamily}" FontSize="14" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Margin="0,0,8,0" Height="28" Style="{StaticResource SettingsComboBox}"
                              ItemsSource="{Binding DataContext.Exclusions.EffectOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedValuePath="Value" DisplayMemberPath="Label"
                              SelectedValue="{Binding EditEffectValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="2" Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="&#xE73E;" Style="{StaticResource RuleIconButtonAccent}" Command="{Binding DataContext.Exclusions.SaveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <Button Content="&#xE711;" Style="{StaticResource RuleIconButtonAccent}" Command="{Binding DataContext.Exclusions.CancelRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="LocalDriveTemplate">
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/><ColumnDefinition Width="70"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEditEnabled}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding State}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                <Button Grid.Column="5"
                        Style="{StaticResource SettingsButton}"
                        MinWidth="72"
                        Height="28"
                        Padding="10,0"
                        Content="{Binding RowActionText}"
                        Command="{Binding RowActionCommand}"
                        IsEnabled="{Binding CanRunRowAction}"
                        Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="NetworkDriveTemplate">
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*" MinWidth="126"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditEnabled}"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Drive, StringFormat={}{0}:}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="4"
                          Width="116"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Style="{StaticResource SettingsComboBox}"
                          ItemsSource="{Binding DataContext.NetworkDrive.RefreshModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding RefreshMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanEditRefreshMode}"/>
                <Button Grid.Column="5"
                        Style="{StaticResource SettingsButton}"
                        MinWidth="72"
                        Height="28"
                        Padding="10,0"
                        Content="{Binding RowActionText}"
                        Command="{Binding RowActionCommand}"
                        IsEnabled="{Binding CanRunRowAction}"
                        Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="WslDriveTemplate">
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*" MinWidth="126"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditEnabled}"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DistroName}" FontSize="13" VerticalAlignment="Center" ToolTip="{Binding UncPath}"/>
                <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="4"
                          Width="116"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Style="{StaticResource SettingsComboBox}"
                          ItemsSource="{Binding DataContext.NetworkDrive.RefreshModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding RefreshMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanEditRefreshMode}"/>
                <Button Grid.Column="5"
                        Style="{StaticResource SettingsButton}"
                        MinWidth="72"
                        Height="28"
                        Padding="10,0"
                        Content="{Binding RowActionText}"
                        Command="{Binding RowActionCommand}"
                        IsEnabled="{Binding CanRunRowAction}"
                        Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="FolderIndexTemplate">
        <Border Style="{StaticResource SettingsRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*" MinWidth="126"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditEnabled}"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="4"
                          Width="116"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Style="{StaticResource SettingsComboBox}"
                          ItemsSource="{Binding DataContext.NetworkDrive.RefreshModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding RefreshMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanEditRefreshMode}"/>
                <Button Grid.Column="5"
                        Style="{StaticResource SettingsButton}"
                        MinWidth="72"
                        Height="28"
                        Padding="10,0"
                        Content="{Binding RowActionText}"
                        Command="{Binding RowActionCommand}"
                        IsEnabled="{Binding CanRunRowAction}"
                        Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
