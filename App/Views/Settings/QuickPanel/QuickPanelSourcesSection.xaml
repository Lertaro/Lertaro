<UserControl x:Class="Lertaro.App.Views.Settings.QuickPanel.QuickPanelSourcesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals"
             xmlns:conv="clr-namespace:Lertaro.App.Converters"
             xmlns:core="clr-namespace:Lertaro.Core;assembly=Lertaro.Core"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="520">
    <!-- Split out of QuickPanelSettingsPage.xaml to keep that file under the project's line-count
         convention. DataContext is the selected QuickPanelTabSettingsViewModel, handed down by the host
         page, so every binding here is one of its members. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>

            <Style x:Key="SourceFieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            </Style>

            <!-- One row per source, which is one group in the panel. Name, path and the row's own
                 buttons share ONE line so a workspace with eight folders is eight lines, not sixteen;
                 anything that needs a decision rather than a glance is behind the chevron. -->
            <DataTemplate x:Key="SourceRowTemplate">
                <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Drag handle: the mouse-drag shortcut for the same reorder the two arrow
                                 buttons do (see DragReorder on the list itself), same six-dot grip every
                                 other reorderable list in Settings uses, and the only place a drag may
                                 start from: a press on the name box or the row background must not
                                 pick the row up by accident. -->
                            <Grid Width="14" Height="22" Margin="0,0,6,0" Background="Transparent"
                                  Cursor="SizeAll" helpers:DragReorder.IsHandle="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="{DynamicResource TextSecondary2}" Margin="1"/>
                                <Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource TextSecondary2}" Margin="1"/>
                                <Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="{DynamicResource TextSecondary2}" Margin="1"/>
                                <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource TextSecondary2}" Margin="1"/>
                                <Ellipse Grid.Row="2" Grid.Column="0" Width="2" Height="2" Fill="{DynamicResource TextSecondary2}" Margin="1"/>
                                <Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource TextSecondary2}" Margin="1"/>
                            </Grid>

                            <CheckBox Grid.Column="1" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"
                                      ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SourceVisibleTooltip]}"/>

                            <Grid Grid.Column="2">
                                <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource RuleTextBox}"
                                         ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SourceNameTooltip]}"/>
                                <!-- The name this group will actually carry, shown while the box is
                                     empty. Without it an unrenamed row is a blank rectangle, and the
                                     built-in sources have no path beside them to hint at it. -->
                                <TextBlock Text="{Binding DefaultName}" IsHitTestVisible="False"
                                           Margin="10,0,6,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DisplayName}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Grid.Column="3" Text="{Binding Path}" Margin="10,0,8,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Path}"
                                       Foreground="{DynamicResource TextSecondary}"
/>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&#xE70E;"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_MoveUpTooltip]}"
                                        Style="{StaticResource RuleIconButton}"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="&#xE70D;"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_MoveDownTooltip]}"
                                        Style="{StaticResource RuleIconButton}"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                                <!-- A Button, not a ToggleButton: a checked ToggleButton paints the
                                     system accent over whatever style it is given, which here came out
                                     as a bright blue block instead of an icon. The glyph carries the
                                     state instead, which is what the row actually needs to show. -->
                                <Button Command="{Binding ToggleOptionsCommand}"
                                        Style="{StaticResource RuleIconButton}"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SourceOptionsTooltip]}"
>
                                    <Button.Content>
                                        <TextBlock Text="&#xE712;">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                                <Button Content="&#xE74D;"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_RemoveSourceTooltip]}"
                                        Style="{StaticResource RuleIconButton}"
                                        Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Shown only when the row is opened. Indented past the grip and the checkbox
                             above it, so the block reads as belonging to the row rather than to the list.
                             A plugin source keeps only the display switch: what it shows is its own
                             decision, so it has no folder, no kind, no filter and no cap to offer. -->
                        <ScrollViewer Margin="54,8,0,6" Focusable="False"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      conv:ScrollViewerHelper.ShiftWheelScrollsHorizontally="True">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource SleekScrollViewerStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource SourceFieldLabel}"
                                           Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}"
                                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SourceKind]}"/>
                                <!-- ItemsSource of value+label pairs, like every other Settings dropdown:
                                     declared items whose Content was a translation binding left the box
                                     blank (the selection matched on identity, not on the value) and would
                                     have had to be rebuilt on a language switch anyway. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                    <ComboBox HorizontalAlignment="Left" MinWidth="200"
                                              Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}"
                                              Style="{StaticResource SettingsComboBox}"
                                              ItemsSource="{Binding KindOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Kind, Mode=TwoWay}"/>
                                    <!-- Beside what the group shows, because it is the other half of the same
                                         question. The panel's own header toggle still overrides it, for the
                                         session it is pressed in; this is what the group opens as. Shares the
                                         panel's own wording by sharing its key. -->
                                    <CheckBox Margin="14,0,0,0" VerticalAlignment="Center"
                                              IsChecked="{Binding ShowAsList, Mode=TwoWay}"
                                              Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_ViewList]}"/>
                                    <CheckBox Margin="14,0,0,0" VerticalAlignment="Center"
                                              Visibility="{Binding IsRecentFiles, Converter={StaticResource InvertBoolToVis}}"
                                              IsChecked="{Binding SortByModified, Mode=TwoWay}"
                                              Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SortByModified]}"/>
                                    <!-- Beside the display options rather than under the folder field: it is
                                         a thing this group does, not a property of the path. -->
                                    <CheckBox Margin="14,0,0,0" VerticalAlignment="Center"
                                              Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}"
                                              IsChecked="{Binding AcceptsDrops, Mode=TwoWay}"
                                              ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_AcceptsDropsTooltip]}"
                                              Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_AcceptsDrops]}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}" Style="{StaticResource SourceFieldLabel}"
                                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SourcePath]}"/>
                                <!-- The same "..." browse button the plugin config's own folder field uses,
                                     and the same shape: the box keeps the width and the button takes what it
                                     needs off the right. -->
                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Content="..." Style="{StaticResource SettingsButton}"
                                            MinWidth="0" Padding="4,0" Width="28" Height="26" Margin="4,0,0,0"
                                            Command="{Binding BrowseCommand}"/>
                                    <TextBox Style="{StaticResource RuleTextBox}"
                                             Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>

                                <TextBlock Grid.Row="2" Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}" Style="{StaticResource SourceFieldLabel}"
                                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_FilterPattern]}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}">
                                    <TextBox Width="150" Style="{StaticResource RuleTextBox}"
                                             Text="{Binding FilterPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ToolTipService.ToolTip>
                                            <TextBlock MaxWidth="420" TextWrapping="Wrap"
                                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_FilterPatternTooltip]}"/>
                                        </ToolTipService.ToolTip>
                                    </TextBox>
                                    <CheckBox Margin="14,0,0,0" VerticalAlignment="Center"
                                              Visibility="{Binding IsRecentFiles, Converter={StaticResource InvertBoolToVis}}"
                                              IsChecked="{Binding Recursive, Mode=TwoWay}"
                                              Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_Recursive]}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}" Style="{StaticResource SourceFieldLabel}"
                                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_MaxItems]}"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsFolderSource, Converter={StaticResource BoolToVis}}">
                                    <TextBox Width="64" Style="{StaticResource RuleTextBox}"
                                             Text="{Binding MaxItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>
                                    <TextBlock Margin="14,0,10,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_MaxAge]}"
                                               Visibility="{Binding IsRecentFiles, Converter={StaticResource BoolToVis}}"/>
                                    <TextBox Width="64" Style="{StaticResource RuleTextBox}"
                                             Visibility="{Binding IsRecentFiles, Converter={StaticResource BoolToVis}}"
                                             Text="{Binding MaxAgeMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right"
                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_AddFolder]}"
                    Style="{StaticResource PrimarySettingsButton}"
                    Command="{Binding AddFolderCommand}"/>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickPanel_SourcesDesc]}"
                       Style="{StaticResource SettingsHintText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
        </DockPanel>

        <!-- No scroll viewer of its own: the page already scrolls, and bounding this one meant an
             expanded row was clipped into a strip you had to scroll inside a scroll. -->
        <ItemsControl x:Name="ListQuickPanelSources" ItemsSource="{Binding Sources}"
                      ItemTemplate="{StaticResource SourceRowTemplate}"
                      helpers:DragReorder.IsEnabled="True"/>
    </StackPanel>
</UserControl>
