<UserControl x:Class="Lertaro.App.Views.Settings.LocalSend.LocalSendSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Style="{StaticResource SettingsSectionTitle}"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Title]}"/>
            <TextBlock Style="{StaticResource SettingsHintText}"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Description]}"
                       Margin="0,4,0,16"/>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- Status Indicator Row -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_StatusTitle]}"
                                       FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_StatusRunningDesc]}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServiceRunning}" Value="False">
                                                <Setter Property="Text" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_StatusStoppedDesc]}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#20107C41"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServiceRunning}" Value="False">
                                            <Setter Property="Background" Value="#208A8886"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#107C41"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServiceRunning}" Value="False">
                                                    <Setter Property="Fill" Value="#8A8886"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_StatusRunning]}"/>
                                            <Setter Property="Foreground" Value="#107C41"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServiceRunning}" Value="False">
                                                    <Setter Property="Text" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_StatusStopped]}"/>
                                                    <Setter Property="Foreground" Value="#8A8886"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,12"/>

                    <DockPanel x:Name="RowLocalSendEnable" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Enable]}"
                                       FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_EnableDesc]}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,12"/>

                    <Grid x:Name="RowLocalSendDeviceAlias" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_DeviceAlias]}"
                                           FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                <Border Margin="6,0,0,0" Padding="5,1,5,1" CornerRadius="3"
                                        Background="{DynamicResource ControlBackground}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeviceHashtag}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_DeviceAliasDesc]}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <TextBox Style="{StaticResource SettingsTextBox}"
                                     Text="{Binding DeviceAlias, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6,26,6"/>
                            <Button Command="{Binding RandomizeAliasCommand}"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_RandomAlias]}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,6,0" Width="18" Height="18"
                                    Background="Transparent" BorderThickness="0"
                                    Focusable="False" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" SnapsToDevicePixels="True">
                                            <TextBlock x:Name="BtnIcon" Text="&#x21BA;" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnIcon" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>

                    <Grid x:Name="RowLocalSendDiscoveryTimeout" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_DiscoveryTimeout]}"
                                       FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_DiscoveryTimeoutDesc]}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding DiscoveryTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,12"/>

                    <Grid x:Name="RowLocalSendReceivePin" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_ReceivePin]}"
                                       FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_ReceivePinDesc]}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding ReceivePin, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,12"/>

                    <DockPanel x:Name="RowLocalSendEnableHttps" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_EnableHttps]}"
                                       FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_EnableHttpsDesc]}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EnableHttps}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,12"/>

                    <DockPanel x:Name="RowLocalSendCreateChecksums" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_CreateChecksums]}"
                                       FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_CreateChecksumsDesc]}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding CreateChecksums}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,12"/>

                    <DockPanel x:Name="RowLocalSendVerifyChecksums" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_VerifyChecksums]}"
                                       FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_VerifyChecksumsDesc]}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding VerifyChecksums}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,12"/>

                    <DockPanel x:Name="RowLocalSendQuickSave" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_QuickSave]}"
                                       FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_QuickSaveDesc]}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding QuickSave}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Grid x:Name="RowLocalSendDownloadDir" Margin="0,0,0,4">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QuickSave}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_DownloadDir]}"
                                       FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding DownloadDirectory}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SettingsButton}"
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Browse]}"
                                Command="{Binding SelectDownloadDirectoryCommand}" Padding="12,0" Height="30"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
