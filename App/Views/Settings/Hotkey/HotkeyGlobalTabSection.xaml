<UserControl x:Class="Lertaro.App.Views.Settings.Hotkey.HotkeyGlobalTabSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             xmlns:ctrl="clr-namespace:Lertaro.App.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="700">
    <!-- Split out of HotkeySettingsPage.xaml (the "Global" tab) to keep that file under the project's
         line-count convention. DataContext is inherited from the host page: this control's own bindings
         are HotkeySettingsViewModel members, same as everything else on that page. SharedSizeGroup
         "HotkeyLabel" still aligns across this control's Grids because Grid.IsSharedSizeScope on the
         host page's outer StackPanel scopes by visual tree, not by NameScope/UserControl boundary. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Group: Global Hotkeys -->
        <TextBlock x:Name="RowGroupGlobal" Style="{StaticResource SettingsGroupTitle}" Margin="0,0,0,10"
                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_GroupGlobal]}"/>

        <Grid x:Name="RowToggleHotkey" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_ToggleLabel]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding ToggleHotkeyValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                RequireModifier="True" AllowBareModifier="True" DefaultValue="Ctrl"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_ToggleDoubleTapHint]}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsHintText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsToggleModifierClick}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <CheckBox x:Name="RowAllowHotkeysInFullscreen" Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0"
                      Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_AllowInFullscreen]}"
                      IsChecked="{Binding AllowHotkeysInFullscreen, Mode=TwoWay}"/>
        </Grid>

        <CheckBox x:Name="RowOpenFullWindowByDefault" Margin="0,6,0,0"
                  Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_OpenFullWindowByDefault]}"
                  IsChecked="{Binding OpenFullWindowByDefault, Mode=TwoWay}"/>

        <Grid x:Name="RowQuickSwitch" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_QuickSwitchLabel]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding QuickSwitchComboHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                RequireModifier="True" DefaultValue="Ctrl+G"/>
        </Grid>

        <TextBlock x:Name="RowSelectionTitle" Style="{StaticResource SettingsSubHeading}" FontSize="15"
                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_SelectionTitle]}"/>

        <Grid x:Name="RowSelectNext" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_SelectNextItem]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding NextItemHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                DefaultValue="Ctrl+N"/>
        </Grid>
        <Grid x:Name="RowSelectPrevious" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_SelectPreviousItem]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding PreviousItemHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                DefaultValue="Ctrl+P"/>
        </Grid>
        <Grid x:Name="RowSelectJump" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_SelectJumpItem]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ctrl:HotkeyRecorderControl Width="90" Height="26"
                    Value="{Binding SelectJumpModifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ModifierOnly="True" DefaultValue="Ctrl"/>
                <TextBlock Text=" + 1~9" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="RowSelectActions" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_SelectActions]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding ActionsMenuHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                DefaultValue="Ctrl+O"/>
        </Grid>
        <Grid x:Name="RowSelectComplete" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_SelectComplete]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding CompleteFromSelectionHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                DefaultValue="Ctrl+Tab"/>
        </Grid>
        <Grid x:Name="RowSelectQuickLook" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_SelectQuickLook]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding QuickLookHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                DefaultValue="Alt+P"/>
        </Grid>
        <Grid x:Name="RowKeywordHistoryPrevious" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_KeywordHistoryPrevious]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding KeywordHistoryPreviousHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                DefaultValue="Alt+Up"/>
        </Grid>
        <Grid x:Name="RowKeywordHistoryNext" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_KeywordHistoryNext]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding KeywordHistoryNextHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                DefaultValue="Alt+Down"/>
        </Grid>
        <Grid x:Name="RowKeywordHistoryDelete" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_KeywordHistoryDelete]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding KeywordHistoryDeleteHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                RequireModifier="True" DefaultValue="Ctrl+Delete"/>
        </Grid>
        <Grid x:Name="RowOpenFullWindow" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_OpenFullWindow]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding OpenFullWindowHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                RequireModifier="True" DefaultValue="Ctrl+F"/>
        </Grid>
        <Grid x:Name="RowLocalSendSendWindow" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_LocalSendSendWindow]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding LocalSendSendWindowHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                RequireModifier="True" DefaultValue="Ctrl+S"/>
        </Grid>
        <Grid x:Name="RowStayOpen" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_StayOpen]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding StayOpenHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                RequireModifier="True" DefaultValue="Ctrl+T"/>
        </Grid>

        <Grid x:Name="RowQuickPanel" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_QuickPanel]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <ctrl:HotkeyRecorderControl Grid.Column="1" Width="200" Height="26"
                Value="{Binding QuickPanelHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                RequireModifier="True" DefaultValue="Ctrl+F2"/>
        </Grid>

        <Border Style="{StaticResource SettingsGroupDivider}"/>

        <!-- Group: Quick Navigation -->
        <TextBlock x:Name="RowGroupQuickNav" Style="{StaticResource SettingsGroupTitle}"
                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_GroupQuickNav]}"/>

        <CheckBox x:Name="RowQuickNavDoubleClick" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_QuickNavDoubleClick]}"
                  IsChecked="{Binding QuickNavTriggerOnDoubleClick, Mode=TwoWay}"
                  Margin="0,4"/>

        <CheckBox x:Name="RowQuickNavMiddleClick" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_QuickNavMiddleClick]}"
                  IsChecked="{Binding QuickNavTriggerOnMiddleClick, Mode=TwoWay}"
                  Margin="0,4"/>

    </StackPanel>
</UserControl>
