<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Controls/TextBox.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Views/Settings/Plugins/FlowCompatibilityStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════ Direct App-Theme Control Reuse for Hosted Panels ═══════════ -->

    <!-- Implicit Button: reuses the app's existing SettingsButton style -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButton}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- Hosted panels keep their compact dimensions while inheriting the app-wide TextBox chrome. -->
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource ThemedTextBox}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Implicit ComboBox: reuses the app's existing SettingsComboBox style -->
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource SettingsComboBox}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource SettingsComboBoxItem}">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Implicit ListBox: themed container background and border -->
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="MinHeight" Value="80"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border CornerRadius="{StaticResource CornerRadiusControl}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit ListBoxItem: reuses the app's exact SidebarItemStyle (matching left sidebar) -->
    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource SidebarItemStyle}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="0,1"/>
    </Style>

    <!-- Implicit TextBlock and Label -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="0,0,0,4"/>
    </Style>

    <!-- Implicit CheckBox -->
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource ThemedCheckBox}">
        <Setter Property="Margin" Value="0,6"/>
    </Style>
</ResourceDictionary>
