<Window x:Class="Lertaro.App.Views.Settings.ConfigRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Lertaro.App.Services"
        xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals"
        Title="Lertaro"
        MinWidth="480" MinHeight="160" MaxWidth="620"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Border CornerRadius="10" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Image x:Name="TitleBarLogo" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtTitle"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[About_ConfigRestoreTitle]}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Click="BtnClose_Click"/>
                    </Grid>
                </Border>

                <!-- Content: hint plus one row per on-disk .bak backup, newest first (the order is
                     already computed by UserConfigBackups.Enumerate; each row's text is preformatted
                     in the constructor, see BackupItem.Display). -->
                <StackPanel Grid.Row="1" Margin="16,14,16,14">
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[About_ConfigRestoreHint]}"
                               Foreground="{DynamicResource TextSecondary2}"
                               TextWrapping="Wrap"/>
                    <ListBox x:Name="BackupsList" MinWidth="420" MaxHeight="320" Margin="0,12,0,0"
                             SelectionChanged="BackupsList_SelectionChanged"
                             MouseDoubleClick="BackupsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Button Bar: OK is disabled until an entry is selected; the title bar's close
                     button and Cancel both leave DialogResult unset, which the caller reads as a
                     cancellation. -->
                <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                    <Grid Margin="12,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnOK" Style="{StaticResource PrimarySettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_OK]}"
                                    Width="80" Height="28" Margin="0,0,12,0" Click="BtnOK_Click" IsDefault="True"/>
                            <Button Style="{StaticResource SettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}"
                                    Width="80" Height="28" Click="BtnClose_Click" IsCancel="True"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
