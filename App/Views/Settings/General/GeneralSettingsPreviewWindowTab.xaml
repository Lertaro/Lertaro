<UserControl x:Class="Lertaro.App.Views.Settings.General.GeneralSettingsPreviewWindowTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <!-- Split out of GeneralSettingsPage.xaml (the "Preview Window" tab) to keep that file under the
         project's line-count convention. DataContext is inherited from the host page, so the
         General.Xxx bindings below resolve exactly as they did when this content lived inline. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/Windows/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,12"
                    Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_PreviewWindowHint]}"/>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid x:Name="RowPreviewWindowWidth" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="GeneralLabel"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_PreviewWindowWidth]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBox}" Text="{Binding General.PreviewWindow.Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>
                </Grid>

                <Grid x:Name="RowPreviewWindowHeight" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="GeneralLabel"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_PreviewWindowHeight]}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBox}" Text="{Binding General.PreviewWindow.Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>
                </Grid>

                <Grid x:Name="RowPreviewWindowReset" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="GeneralLabel"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_PreviewWindowReset]}"
                            Command="{Binding General.PreviewWindow.ResetCommand}"
                            Style="{StaticResource SettingsButton}"
                            Margin="0" HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
