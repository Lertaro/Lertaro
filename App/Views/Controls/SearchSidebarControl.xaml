<UserControl x:Class="Lertaro.App.Views.Controls.SearchSidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles/Windows/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,12,0,12">
                <!-- Dynamic Plugins Sections (Fully Plugin-ized Sidebar) -->
                <ItemsControl ItemsSource="{Binding DynamicSidebarGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}" Margin="18,12,18,12">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <DockPanel Margin="20,4,20,6" LastChildFill="True">
                                    <!-- Visibility toggles Hidden/Visible, not Collapsed/Visible: Collapsed
                                         would remove the button from layout entirely, so the row's height
                                         (driven by the taller of the two children) would shrink/grow as
                                         selections come and go, jittering the whole sidebar underneath it.
                                         Hidden keeps its layout space reserved while still not rendering
                                         or accepting input when there's nothing to clear. -->
                                    <Button DockPanel.Dock="Right" Content="&#xE711;"
                                            Command="{Binding ClearCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarClearButtonStyle}">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <!-- ItemsControl (not ListBox): each item toggles its own IsSelected
                                     independently: a single-select group enforces "only one at a time"
                                     itself (DynamicSidebarGroupViewModel.OnItemSelectionChanged), a
                                     multi-select group leaves every item free to combine with OR. -->
                                <ItemsControl ItemsSource="{Binding Items}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource SidebarFilterItemStyle}"
                                                          HorizontalAlignment="Stretch"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                <DockPanel LastChildFill="True">
                                                    <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" Width="14" Height="14">
                                                        <TextBlock x:Name="TxtIcon" Text="{Binding IconString}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Path x:Name="PathIcon" Data="{Binding IconData}" Stretch="Uniform" Visibility="Collapsed"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                    </Grid>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                                                               Margin="10,0,0,0" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayName}"  FontSize="13"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </ToggleButton>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasIconData}" Value="True">
                                                    <Setter TargetName="TxtIcon" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="PathIcon" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
