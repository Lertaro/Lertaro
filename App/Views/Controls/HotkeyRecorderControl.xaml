<UserControl x:Class="Lertaro.App.Views.Controls.HotkeyRecorderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services"
             Height="26" Width="180">
    <UserControl.Resources>
        <VisualBrush x:Key="PlaceholderBrush" TileMode="None" Stretch="None"
                     AlignmentX="Center" AlignmentY="Center">
            <VisualBrush.Visual>
                <Label Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_RecorderPlaceholder]}"
                       Foreground="{DynamicResource TextSecondary}"
                       Opacity="0.5" FontSize="12"/>
            </VisualBrush.Visual>
        </VisualBrush>
        <Style x:Key="RecorderBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="ContextMenu" Value="{x:Null}"/>
            <Setter Property="Padding" Value="6,2,20,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconButtonBaseStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <!-- Exactly one of these two is visible at a time: clear while a combo is set, restore once cleared. -->
        <Style x:Key="ClearButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonBaseStyle}">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="&#x2715;" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=HotkeyBox}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, ElementName=HotkeyBox}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RestoreButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonBaseStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="&#x21BA;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=HotkeyBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, ElementName=HotkeyBox}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Width="{Binding Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
          Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <TextBox x:Name="HotkeyBox"
                 Style="{StaticResource RecorderBoxStyle}"
                 IsReadOnly="True"
                 ContextMenu="{x:Null}"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                 PreviewKeyUp="HotkeyBox_PreviewKeyUp"/>
        <Button Style="{StaticResource ClearButtonStyle}"
                Click="ClearButton_Click"
                ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_RecorderClear]}"/>
        <Button Style="{StaticResource RestoreButtonStyle}"
                Click="RestoreButton_Click"
                ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Hotkeys_RecorderRestoreDefault]}"/>
    </Grid>
</UserControl>
