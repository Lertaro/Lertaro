<Window x:Class="Lertaro.App.Views.Controls.Dialogs.PluginFieldPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Lertaro.App.Services"
        xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals"
        Title="Lertaro"
        MinWidth="480" MinHeight="160" MaxWidth="620" MaxHeight="800"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded">

    <!-- MaxWidth above doubles as the wrap width. SizeToContent still shrinks a short prompt to its
         own content, but a field with a long description has no reason to stop before the cap, so the
         cap is what that text wraps at: 900 meant one line running most of the screen. 620 reads as a
         dialog and still clears the widest thing a field can be, the object array master/detail table
         at roughly 520. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/SearchWindow.xaml"/>
                <!-- Pulls in FieldValueEditorStyle and the implicit PluginConfigFieldViewModel row
                     template, plus (transitively) SettingsWindow.xaml: the same resources the real
                     Settings, Plugins, Configure dialog renders each field with, so a prompt built
                     from this looks and behaves identically. -->
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Views/Settings/Plugins/FieldRowTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Border CornerRadius="10" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <!-- Auto here (not *) so SizeToContent can compute a real, finite height on first
                         open: a Star row measured against SizeToContent's infinite available space is
                         also unconstrained, sizing the window to nearly the full screen. Window_Loaded
                         switches this to Star once SizeToContent has already locked in a real size,
                         mirroring PluginConfigWindow's own fix for the same issue. -->
                    <RowDefinition x:Name="ContentRow" Height="Auto"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Image x:Name="TitleBarLogo" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtTitle" Text="Lertaro"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Click="BtnClose_Click"/>
                    </Grid>
                </Border>

                <!-- Content Area: one row per field, using the exact same DataTemplate the real
                     Configure dialog renders PluginConfigFieldViewModel with (see FieldRowTemplate.xaml,
                     merged above). -->
                <!-- Vertical only. Scrolling sideways would give the field rows an unbounded width,
                     and a row's wrapping description measures itself against exactly that width, so
                     allowing it here stops the descriptions wrapping. With it disabled the rows are
                     bounded by the window, whose MaxWidth caps how wide SizeToContent can take it. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Margin="16,14,16,14">
                    <!-- IsSharedSizeScope lets every field row's editor column (SharedSizeGroup="FieldEditor"
                         in FieldRowTemplate.xaml) sync to the widest editor on screen, same as
                         PluginConfigWindow's own content list. -->
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <ItemsControl x:Name="FieldsControl"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Button Bar: OK only. The title bar's close button cancels, matching
                     PluginConfigWindow's own IsSaved-defaults-false semantics, so a separate Cancel
                     button next to OK would just be a second way to do the same thing.

                     Escape is deliberately not wired up to cancel as well. Reaching the fields ahead
                     of the focused editor means handling it in the tunnelling pass, which is exactly
                     where an editor that wants the key for itself would be waiting for it: a hotkey
                     recorder field takes Escape to clear what it is recording, and a window-level
                     handler would swallow that before the field ever saw it. -->
                <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                    <Grid Margin="12,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimarySettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_OK]}"
                                    Width="80" Height="28" Click="BtnOK_Click" IsDefault="True"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
