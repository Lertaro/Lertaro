<Window x:Class="Lertaro.App.Views.Controls.Dialogs.CustomMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Lertaro.App.Services"
        xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals"
        Title="Lertaro"
        Width="440" MinHeight="180" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <!-- ClipToBounds ignores CornerRadius (a WPF limitation, not a bug here): helpers:RoundedClip
             builds a real rounded-rect Clip instead: child content flush to the edge would otherwise show
             square corners poking past this Border's own rounded paint. -->
        <Border CornerRadius="10" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Image x:Name="TitleBarLogo" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtTitle" Text="Lertaro"
                                        FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Title Bar (no close button needed for simple alert message boxes) -->
                    </Grid>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Row="1" Margin="20,18,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <TextBlock x:Name="TxtIcon" Grid.Column="0" 
                               FontFamily="Segoe MDL2 Assets" FontSize="28" 
                               VerticalAlignment="Top" Margin="0,2,0,0"/>

                    <!-- Message Text: scrolls instead of growing the window past the screen for long
                         content (e.g. an update-check exception's full stack trace). -->
                    <ScrollViewer Grid.Column="1" MaxHeight="400" VerticalScrollBarVisibility="Auto"
                                  VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock x:Name="TxtMessage"
                                   TextWrapping="Wrap" FontSize="13.5" LineHeight="20"
                                   Foreground="{DynamicResource TextPrimary2}"/>
                    </ScrollViewer>
                </Grid>

                <!-- Button Bar -->
                <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                    <Grid Margin="12,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnYes" Style="{StaticResource PrimarySettingsButton}" 
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Yes]}" 
                                    Width="80" Height="28" Margin="0,0,8,0" Click="BtnYes_Click"/>
                            <Button x:Name="BtnNo" Style="{StaticResource SettingsButton}" 
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_No]}" 
                                    Width="80" Height="28" Margin="0,0,8,0" Click="BtnNo_Click"/>
                            <Button x:Name="BtnOK" Style="{StaticResource PrimarySettingsButton}" 
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_OK]}" 
                                    Width="80" Height="28" Margin="0,0,8,0" Click="BtnOK_Click"/>
                            <Button x:Name="BtnCancel" Style="{StaticResource SettingsButton}" 
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}" 
                                    Width="80" Height="28" Click="BtnCancel_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
