<Window x:Class="Lertaro.App.QuickSearchWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lertaro.App"
        xmlns:results="clr-namespace:Lertaro.App.Views.Controls.Results"
        xmlns:services="clr-namespace:Lertaro.App.Services"
        xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals"
        xmlns:ctrl="clr-namespace:Lertaro.App.Views.Controls"
        xmlns:quick="clr-namespace:Lertaro.App.Views.QuickSearchWindow"
        xmlns:converters="clr-namespace:Lertaro.App.Converters"
        Title="Lertaro"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackground}"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <converters:CategoryDisplayNameConverter x:Key="CategoryName"/>

        <!-- One filter. The pipe is drawn on the left of each filter and hidden on the first, so the row
             starts and ends on a label instead of a rule. The selected underline is this item's own bottom
             border: the Border hugs its content, so the line is the label's width without measuring the
             text, and it follows a resize, a scale change, a translation, or a first paint on its own. -->
        <Style x:Key="CategoryCardStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="3,3"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Rectangle x:Name="Pipe"
                                       Width="1"
                                       Margin="0,3,0,3"
                                       HorizontalAlignment="Left"
                                       Fill="{DynamicResource SeparatorBrush}"
                                       Opacity="0.45"/>
                            <Border x:Name="Underline"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    BorderBrush="Transparent"
                                    BorderThickness="0,0,0,1.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- No leading pipe on the first filter. Needs AlternationCount on the ListBox;
                                 when it is unset the attached index is -1 and this simply never fires. -->
                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                <Setter TargetName="Pipe" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A bare ItemsPresenter, with no Border, ScrollViewer or focus chrome of its own: the default
             template draws its own chrome and lays a full-width strip behind the row. Equal-width cells
             across the line so the filters spread out instead of bunching at the left edge. -->
        <Style x:Key="CategoryBarStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CategoryCardStyle}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid x:Name="RootGrid">
        <!-- Deliberately no drag handlers on this card (#255): the window is moved ONLY by dragging the
             Lertaro logo in the search box, so a press anywhere on the card - its edge and its empty
             results area included - must do nothing at all. See QuickSearchWindow.xaml.cs for the logo's
             own gate. -->
        <!-- The card IS the window: an opaque surface, whose corners the window manager rounds
             (QuickSearchWindow.xaml.cs parks it and applies that), so nothing here is painted for a
             transparent margin's sake and every glyph in it can be antialiased sub-pixel. -->
        <Border x:Name="CardBorder" Margin="24,40,24,24" CornerRadius="{StaticResource CornerRadiusWindow}" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">

            <!-- ClipToBounds ignores CornerRadius (a WPF limitation, not a bug here): helpers:RoundedClip
                 builds a real rounded-rect Clip instead: child content flush to the edge would otherwise show
                 square corners poking past this Border's own rounded paint. -->
            <Border CornerRadius="7" helpers:RoundedClip.IsEnabled="True">
                <Grid Width="{Binding SearchBarWidth}">
            <Grid.RowDefinitions>
                <!-- Search bar -->
                <RowDefinition Height="Auto"/>
                <!-- Category filter -->
                <RowDefinition Height="Auto"/>
                <!-- Separator -->
                <RowDefinition Height="Auto"/>
                <!-- Results panel (grows with content) -->
                <RowDefinition Height="Auto"/>
                <!-- Status bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ 1. Search Bar ═══════════ -->
            <local:SearchBoxControl x:Name="SearchBox" Grid.Row="0" SearchText="{Binding SearchQuery, Mode=TwoWay}"
                                    Height="{Binding SearchBarHeight}" IsDynamicScalingEnabled="True"
                                    LeftIconSize="34" RightIconSize="34"
                                    HorizontalAlignment="Stretch" IsServiceRunning="{Binding IsServiceConnected}"/>

            <!-- ═══════════ 2. Category filter ═══════════ -->
            <!-- Shown with the results and hidden when there are none, so the bar never widens the card on
                 an empty search. -->
            <ListBox x:Name="CategoryBar"
                     Grid.Row="1"
                     Margin="12,1,12,2"
                     AlternationCount="64"
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     Style="{StaticResource CategoryBarStyle}"
                     ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     Visibility="{Binding ResultsPanelVisibility}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Trimming rather than growth: the row is nine equal cells inside a width the user
                             set, and a locale whose words do not fit that has to lose letters, not card width. -->
                        <TextBlock Text="{Binding Converter={StaticResource CategoryName}}"
                                   Opacity="0.85"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ═══════════ 3. Separator ═══════════ -->
            <Rectangle x:Name="ResultsSeparator"
                       Grid.Row="2"
                       Height="1"
                       Margin="12,0,12,0"
                       Fill="{DynamicResource SeparatorBrush}"
                       Visibility="{Binding ResultsSeparatorVisibility}"/>

            <!-- Recessed content tier behind the results rows, matching SearchWindow's own
                 "Main Results Grid" (Background=ContentBg, a shade back from the outer CardBackground
                 chrome/search bar) so every window's results area reads the same instead of being flat
                 CardBackground everywhere with no depth. -->
            <Border Grid.Row="3" Grid.RowSpan="2" Background="{DynamicResource ContentBg}"/>

            <quick:QuickSearchLaunchPanel x:Name="LaunchPanelControl" Grid.Row="3"
                                          Visibility="{Binding LaunchPanelVisibility}"/>

            <!-- ═══════════ 4. Results Panel ═══════════ -->
            <results:ResultsControl x:Name="ResultsPanelControl" Grid.Row="3"
                                  UsesFloatingActionsLayout="True"
                                  ItemsSource="{Binding Results}"
                                  SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                  ViewMode="List"
                                  Visibility="{Binding ResultsPanelVisibility}"/>

            <!-- ═══════════ 5. Status bar (shown when loading or ready) ═══════════ -->
            <local:StatusBarControl x:Name="StatusBarControl" Grid.Row="4"
                                    Visibility="{Binding StatusBarVisibility}"/>
        </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
