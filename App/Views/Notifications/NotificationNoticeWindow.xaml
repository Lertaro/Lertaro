<Window x:Class="Lertaro.App.Views.Notifications.NotificationNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource ContentBg}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- One line, nothing to click: this window exists to say something briefly, and every control on it
         would be a place the user's pointer has to be aimed at. ContentBg is the surface this project keeps
         for a window floating over someone else's content. It is opaque now, and the corners are the window
         manager's rounding rather than a painted radius: a see-through notification would have to be a
         layered window again, which is the one thing that cost both ClearType and every animation frame. -->
    <Border x:Name="Surface" Height="36" Padding="12,0" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <TextBlock x:Name="Line"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextPrimary}"/>
    </Border>
</Window>
