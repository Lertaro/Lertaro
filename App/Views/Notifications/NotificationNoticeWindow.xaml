<Window x:Class="Lertaro.App.Views.Notifications.NotificationNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- One line, nothing to click: this window exists to say something briefly, and every control on it
         would be a place the user's pointer has to be aimed at. ContentBg is the surface this project uses
         for a window floating over someone else's content, kept just translucent so it reads as an
         overlay rather than a hole punched in the screen. -->
    <Border Height="36" Padding="12,0" Opacity="0.93"
            CornerRadius="{StaticResource CornerRadiusWindow}"
            Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <TextBlock x:Name="Line"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextPrimary}"/>
    </Border>
</Window>
