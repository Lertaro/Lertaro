<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <Style x:Key="QuickPanelGroupToggleStyle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bar" Background="Transparent" CornerRadius="6" Padding="8,3,8,3">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="Chevron" Grid.Column="0" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       Foreground="{DynamicResource TextSecondary2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource ItemHover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Used by both the in-flow expander and its sticky copy; only the sticky border lives outside
         this template, so title, controls and commands cannot drift apart. -->
    <DataTemplate x:Key="QuickPanelGroupHeaderTemplate">
        <Grid Margin="0,2,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- The toggle owns the whole descriptive header, matching a native tree row: a user can
                 click the name, path, or line instead of having to target the small chevron. The
                 adjacent view controls remain ordinary buttons and do not collapse the group. -->
            <ToggleButton Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource QuickPanelGroupToggleStyle}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}"
                                   VerticalAlignment="Center" Text="{Binding Title}"
                                   Visibility="{Binding ShowsHeading, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondary2}"
                                   VerticalAlignment="Center" Text="{Binding Count, StringFormat=({0})}"
                                   Visibility="{Binding ShowsHeading, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" FontSize="11" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondary2}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Text="{Binding FolderPath}"/>
                    <Border Grid.Column="2" Height="1" Margin="10,0,10,0" VerticalAlignment="Center"
                            Background="{DynamicResource SeparatorBrush}"/>
                </Grid>
            </ToggleButton>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ToggleSortCommand}" Style="{DynamicResource QuickPanelSortToggleStyle}"/>
                <Button Command="{Binding ToggleViewCommand}" Margin="2,0,0,0"
                        Style="{DynamicResource QuickPanelViewToggleStyle}"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <Style x:Key="QuickPanelGroupExpanderStyle" TargetType="Expander">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <Border x:Name="DropOutline" BorderThickness="1" CornerRadius="6" BorderBrush="Transparent" Background="Transparent">
                <StackPanel>
                    <ContentPresenter Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                    <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True"><Setter TargetName="DropOutline" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/></DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
