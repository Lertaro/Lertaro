<UserControl x:Class="Lertaro.App.Views.LocalSend.LocalSendSendProgressPanel"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:Lertaro.App.Views.LocalSend"
              xmlns:converters="clr-namespace:Lertaro.App.Converters"
              xmlns:services="clr-namespace:Lertaro.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/LocalSendWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="16,14,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,8"><TextBlock Text="{Binding SpeedText}" FontSize="11.5" Foreground="{DynamicResource AccentBlue}" FontWeight="SemiBold"/><TextBlock Text="{Binding ConfirmedCounterText}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
            <Border Grid.Row="1" Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8">
                <ListBox ItemsSource="{Binding TransferItems}" Background="Transparent" BorderThickness="0" Margin="4" Focusable="False" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource LocalSendProgressListBoxItemStyle}" ItemTemplate="{StaticResource LocalSendProgressFileItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" converters:ScrollViewerHelper.AlwaysShowScrollBarWhenNeeded="True"/>
            </Border>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="{Binding ActionText, RelativeSource={RelativeSource AncestorType={x:Type local:LocalSendSendProgressPanel}}}" Click="Action_Click" Style="{StaticResource SettingsButton}" Width="80" Height="30"/></StackPanel>
        </Border>
    </Grid>
</UserControl>
