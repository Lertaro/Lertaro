<Window x:Class="Lertaro.App.Views.LocalSend.LocalSendReceiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Lertaro.App.Services"
        xmlns:converters="clr-namespace:Lertaro.App.Converters"
        xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals"
        Title="LocalSend"
        Height="390" Width="460" MinWidth="420" MinHeight="310"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.25" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Border CornerRadius="12" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Title Bar -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Image x:Name="TitleBarLogo" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtWindowTitle"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_UploadRequestTitle]}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Central Main Content Region: Shared File List Box -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>

                    <!-- Header Row: Sender Info & Select All Button -->
                    <Grid Grid.Row="0" Margin="16,12,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtSender" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary2}"/>
                                <Ellipse x:Name="SenderSecureIndicator" Width="7" Height="7" Margin="5,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource SuccessBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtSummary" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Step 2 Progress Summary / Counter -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtSpeed" FontSize="11.5" Foreground="{DynamicResource AccentBlue}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtCounter" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <Button x:Name="BtnToggleSelectAll" Grid.Column="2" VerticalAlignment="Center"
                                Content="全选 / 取消全选" Click="BtnToggleSelectAll_Click"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource AccentBlue}" Cursor="Hand"
                                FontSize="12" Padding="4,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               Cursor="Hand" VerticalAlignment="Center"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Shared ListBox with Per-File Individual Progress Bars -->
                    <Border Grid.Row="1" Margin="16,0,16,8" MaxHeight="220" Background="{DynamicResource FieldBackground}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8">
                        <ListBox x:Name="LstFiles" Background="Transparent" BorderThickness="0" Margin="4"
                                 SelectionMode="Multiple" SelectionChanged="LstFiles_SelectionChanged"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 converters:ScrollViewerHelper.AlwaysShowScrollBarWhenNeeded="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                                               RadiusX="1.5" RadiusY="1.5" Fill="Transparent" Margin="2,4"/>
                                                    <Border x:Name="ItemBorder"
                                                            Background="Transparent"
                                                            CornerRadius="6"
                                                            Padding="8,6"
                                                            Margin="8,2,2,2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBackground}"/>
                                                        <Setter TargetName="AccentBar" Property="Fill" Value="{DynamicResource AccentBarColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Normal File Name -->
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                                                       FontSize="12" Foreground="{DynamicResource TextPrimary2}" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                            <!-- Normal File Size/Status -->
                                            <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding SizeText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowProgress}" Value="True">
                                                                <Setter Property="Text" Value="{Binding StatusText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Row 1: Individual File Progress Bar -->
                                        <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage, Mode=OneWay}"
                                                     Minimum="0" Maximum="100" Height="3.5" Margin="0,5,0,1"
                                                     Foreground="{DynamicResource AccentBlue}" Background="{DynamicResource ControlBorderBrush}"
                                                     BorderThickness="0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowProgress}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Overall Session Progress Bar -->
                    <ProgressBar x:Name="PbTransfer" Grid.Row="2" Height="4" Margin="16,0,16,8"
                                 Minimum="0" Maximum="100" Visibility="Collapsed"
                                 Foreground="{DynamicResource AccentBlue}" BorderThickness="0"/>

                    <!-- Footer Action Bar: Step 1 vs Step 2 -->
                    <Border Grid.Row="3" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,0">
                        <Grid>
                            <!-- Step 1 Footer Buttons -->
                            <Grid x:Name="GridStep1Footer" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnDecline" Grid.Column="0" Height="30" Width="80" HorizontalAlignment="Left"
                                        Style="{StaticResource SettingsButton}"
                                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Decline]}"
                                        Click="BtnDecline_Click"/>

                                <Button x:Name="BtnSaveTo" Grid.Column="1" Height="30" Padding="12,0" Margin="0,0,8,0"
                                        Style="{StaticResource SettingsButton}"
                                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_SaveTo]}"
                                        Click="BtnSaveTo_Click"/>

                                <Button x:Name="BtnAcceptDefault" Grid.Column="2" Height="30" Padding="16,0"
                                        Style="{StaticResource PrimarySettingsButton}"
                                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_AcceptDefault]}"
                                        Click="BtnAcceptDefault_Click"/>
                            </Grid>

                            <!-- Step 2 Footer Buttons -->
                            <StackPanel x:Name="PanelStep2Footer" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnOpenFolder" Height="30" Padding="12,0" Margin="0,0,8,0" Visibility="Collapsed"
                                        Style="{StaticResource PrimarySettingsButton}"
                                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_OpenFolder]}"
                                        Click="BtnOpenFolder_Click"/>

                                <Button x:Name="BtnCloseProgress" Height="30" Padding="16,0" Width="80"
                                        Style="{StaticResource SettingsButton}"
                                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}"
                                        Click="BtnCloseProgress_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
