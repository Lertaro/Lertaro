<UserControl x:Class="Lertaro.App.Views.LocalSend.LocalSendDevicePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:services="clr-namespace:Lertaro.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/LocalSendWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="16,14,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Device]}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary2}" Margin="0,0,0,8"/>
            <Border Grid.Row="1" Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8">
                <ListBox x:Name="DeviceList" ItemsSource="{Binding DiscoveredDevices}" SelectionMode="Multiple" SelectionChanged="DeviceList_SelectionChanged" Background="Transparent" BorderThickness="0" Margin="4" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Fill="Transparent" Margin="2,4"/>
                                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="8,6" Margin="8,2,2,2">
                                                <ContentPresenter/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBackground}"/><Setter TargetName="AccentBar" Property="Fill" Value="{DynamicResource AccentBarColor}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,4,0"><Path Fill="{DynamicResource TextSecondary}" Data="{Binding DeviceTypeIcon}" Stretch="Uniform"/></Viewbox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Alias}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary2}" TextTrimming="CharacterEllipsis"/>
                                        <Ellipse Width="7" Height="7" Margin="5,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource SuccessBrush}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsesHttps}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"><Run Text="#"/><Run Text="{Binding FingerprintTag, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DeviceModel, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding IpAddress}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Grid.Column="3" Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ThemeTextBoxStyle}" Height="26" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Button x:Name="SelectAllButton" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_SelectAll], Mode=OneWay}" Click="SelectAll_Click" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Width="70" Height="30"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Cancel]}" Click="Cancel_Click" Style="{StaticResource SettingsButton}" Margin="0,0,8,0" Width="80" Height="30"/>
                    <Button x:Name="SendButton" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_Send]}" Click="Send_Click" Style="{StaticResource PrimarySettingsButton}" IsDefault="True" Width="85" Height="30" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
