<Window x:Class="Lertaro.App.Views.LocalSend.LocalSendSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Lertaro.App.Services"
        xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals"
        xmlns:local="clr-namespace:Lertaro.App.Views.LocalSend"
        Title="LocalSend" Height="400" Width="480" MinWidth="420" MinHeight="320"
        WindowStartupLocation="Manual" Background="{DynamicResource ContentBg}"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Topmost="True"
        TextElement.Foreground="{DynamicResource TextPrimary}">
    <!-- The window is opaque, which is what lets its text be antialiased sub-pixel; the chrome is what makes
         an opaque borderless window behave, with a resize border of 0 so the edge does not claim the pointer
         away from the content against it. The grip is what resizes this window, and its hit area is declared
         in ResizeGrip.xaml.
         CaptionHeight is 0 deliberately: this window drags from its own title bar
         (TitleBar_MouseLeftButtonDown), so the chrome must not claim a caption area of its own.
         The startup location is Manual: CenterScreen sizes the window with the system scale and centers for
         that, which on a different-DPI monitor is not its own center. LocalSendAppEventHandler places it with
         WindowCentering.CenterOnCursorScreen. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles/Windows/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- The card IS the window. The 8 DIP margin this used to carry was a transparent halo for a shadow the
         layered window could paint into; an opaque window has no such pixels, so nothing is left to reserve. -->
    <Border CornerRadius="{StaticResource CornerRadiusWindow}" Background="{DynamicResource ContentBg}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Border CornerRadius="{StaticResource CornerRadiusWindow}" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image x:Name="TitleBarLogo" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtWindowTitle" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalSend_SendWindowTitle]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary2}"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <local:LocalSendCollectPanel x:Name="CollectPanel" CloseRequested="Panel_CloseRequested" NextRequested="Panel_NextRequested"/>
                    <local:LocalSendDevicePanel x:Name="DevicePanel" CloseRequested="Panel_CloseRequested" SendRequested="DevicePanel_SendRequested"/>
                    <local:LocalSendSendProgressPanel x:Name="ProgressPanel" ActionRequested="ProgressPanel_ActionRequested"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
