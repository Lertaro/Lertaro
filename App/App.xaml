<Application x:Class="Lertaro.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/QuickSearchWindow/QuickSearchWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/DataTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global font family and default text color -->
            <Style TargetType="Window">
                
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <Style TargetType="UserControl">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <!-- Global implicit TextBlock style -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
