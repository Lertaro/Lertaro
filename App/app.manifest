<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Lertaro.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Run as standard user (non-admin) by default -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- Per-monitor V2 DPI awareness: the window positioning helpers multiply Win32 pixel rects
       (GetWindowRect, GetDpiForMonitor) by a per-monitor scale, which is only correct when the
       process itself sees per-monitor coordinates. Without this declaration the process falls
       back to system-DPI virtualization and every mixed-DPI multi-monitor position lands wrong,
       with blurry windows on secondary displays. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
