<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVM>false</RetainVM>
    <AssemblyName>Lertaro.App</AssemblyName>
    <RootNamespace>Lertaro.App</RootNamespace>
    <Version>5.9.1</Version>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\PluginSdk\PluginSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lertaro.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="logo.ico" />
  </ItemGroup>

  <!-- The host must remain usable with every plugin disabled. Share the existing resource sources,
       but compile the fallback resources into the host, not a plugin DLL. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Plugins\CoreExtensions\Resources\Translations\**\App.json" Link="Resources\Translations\%(RecursiveDir)App.json" />
    <Page Include="..\Plugins\CoreExtensions\Resources\Themes\Light.xaml" Link="Resources\Themes\Light.xaml" />
    <Page Include="..\Plugins\CoreExtensions\Resources\Themes\Dark.xaml" Link="Resources\Themes\Dark.xaml" />
  </ItemGroup>

</Project>
