<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Kept separate from SettingsWindow.xaml to keep that window below the repository's per-file line limit. -->
    <Style x:Key="SidebarNavigationIcon" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                <Setter Property="Margin" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarNavigationLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingsSidebarItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SidebarText}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTipService.IsEnabled"
                Value="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <!-- Left accent bar for selected item -->
                        <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                   RadiusX="1.5" RadiusY="1.5" Fill="Transparent" Margin="0,4"/>
                        <Border x:Name="ItemBorder" CornerRadius="7"
                                Background="Transparent" Padding="{TemplateBinding Padding}" Margin="8,2,8,2">
                            <ContentPresenter x:Name="ContentPresenterHost"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHover}"/>
                            <Setter TargetName="AccentBar" Property="Fill" Value="{DynamicResource AccentBarColor}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SidebarTextActive}"/>
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SidebarTextActive}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                            <Setter Property="Padding" Value="0,8"/>
                            <Setter TargetName="ContentPresenterHost" Property="HorizontalAlignment" Value="Center"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
