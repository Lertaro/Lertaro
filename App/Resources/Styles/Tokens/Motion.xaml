<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════ Motion Tokens ═══════════
         Durations are pinned to the one timing decision already made in this codebase:
         ThemeManager's 120ms/180ms theme-swap fade (App/Services/ThemeManager.cs), rather than
         picked fresh, so new transitions feel like the same product as the existing one. -->

    <Duration x:Key="DurationFast">0:0:0.12</Duration>
    <Duration x:Key="DurationHover">0:0:0.15</Duration>
    <!-- Matches RippleAdorner's existing hardcoded 400ms click ripple. -->
    <Duration x:Key="DurationRipple">0:0:0.4</Duration>
    <!-- Window summon/dismiss fade, same 120ms-out/180ms-in asymmetry as ThemeManager's own
         theme-swap fade: DurationFast doubles as the fade-out leg. -->
    <Duration x:Key="DurationWindowFadeIn">0:0:0.18</Duration>

    <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut"/>
    <ExponentialEase x:Key="EaseOutExponential" EasingMode="EaseOut"/>

</ResourceDictionary>
