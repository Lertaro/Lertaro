<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:Lertaro.App"
                    xmlns:local="clr-namespace:Lertaro.App.Converters"
                    xmlns:services="clr-namespace:Lertaro.App.Services"
                    xmlns:helpers="clr-namespace:Lertaro.App.Helpers.Visuals">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/Tokens/Colors.xaml"/>
        <ResourceDictionary Source="DataTemplates/ShortcutHintBadge.xaml"/>
        <ResourceDictionary Source="DataTemplates/InlineSearchResult.xaml"/>
        <ResourceDictionary Source="DataTemplates/ActionMenuItem.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════ Search Result Item Template ═══════════ -->
    <DataTemplate x:Key="SearchResultTemplate" DataType="{x:Type app:AppSearchResult}">
        <DockPanel LastChildFill="True">
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource AccentBlue}"
                       VerticalAlignment="Center"
                       Text="{Binding Name}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchSectionHeader}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- File/Folder icon -->
            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Margin="0,0,14,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Setter Property="Width" Value="{Binding EffectiveIconSize}"/>
                        <Setter Property="Height" Value="{Binding EffectiveIconSize}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmptyResult}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSearchSectionHeader}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsListItem}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <!-- Shared badge markup: see ShortcutHintBadge.xaml's own comment for the full design
                 history. FontSize is set here (not inside the shared template) so this window's own
                 11pt badge text stays exactly what it was before the badge was shared with the
                 inline search window's 12pt version. Docked to the Right so long title text in the
                 center never compresses or clips the badge. -->
            <ContentPresenter DockPanel.Dock="Right"
                               TextElement.FontSize="11"
                               Content="{Binding}"
                               ContentTemplate="{StaticResource ShortcutHintBadgeTemplate}"/>

            <!-- "Frequent" marker: rows the user opens often enough to enter a history tier (H5/H3) in the
                 quick window. A quiet wash like the shortcut badge, so a selected row's own background does
                 not swallow it; text-only because the row is already dense. -->
            <Border DockPanel.Dock="Right"
                    Margin="10,0,0,0"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsFrequent, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Border CornerRadius="4" IsHitTestVisible="False" Background="{DynamicResource HoverBackground}" Opacity="0.5"/>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_ResultFrequent]}"
                               Padding="7,2,7,2"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Name + directory path -->
            <StackPanel VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmptyResult}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSearchSectionHeader}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                              local:ScrollViewerHelper.BubbleMouseWheel="True">
                    <TextBlock 
                               Foreground="{DynamicResource TextPrimary}"
                               local:TextHighlighter.Text="{Binding Name}"
                               local:TextHighlighter.HighlightText="{Binding SearchQuery}"
                               local:TextHighlighter.HighlightBrush="{DynamicResource AccentBlue}"
                               helpers:MarqueeBehavior.EnableMarquee="True">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="{Binding EffectiveNameFontSize}"/>
                                <Setter Property="TextAlignment" Value="Left"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="TextTrimming" Value="None"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmptyResult}" Value="True">
                                        <Setter Property="FontSize" Value="24"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ScrollViewer>
                <!-- No ScrollViewer around the path row: it only existed for the marquee, and it doubled the
                     heaviest container in this template (self-templated, focus management, scroll logic) in
                     every list item. Trimming keeps the beginning of the path, which is the part that says
                     where the file lives. Measured: the paint of a 200-row list was 60-100 ms, and two
                     scroll viewers per row were the largest single contributor. -->
                <TextBlock Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding ParentDir}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{Binding PathFontSize}"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApplication}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- Blank subtitle (e.g. applications) shows name-only: hide the empty row. -->
                                <DataTrigger Binding="{Binding ParentDir}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEmptyResult}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
