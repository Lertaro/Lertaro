{
    "version": "5.13.7",
    "description": "File search and productivity launcher for Windows.",
    "homepage": "https://github.com/Lertaro/Lertaro",
    "license": "MIT",
    "notes": [
        "This package requires an administrator shell and 'scoop install --global lertaro/lertaro-np'.",
        "The official installer manages the application, Windows service, and .NET 10 Desktop Runtime in Program Files; Scoop tracks the package separately.",
        "Settings stay in LocalAppData and ProgramData. Open a new terminal to use the lff command.",
        "This shares one installation with WinGet and manual installs. Use one package manager to maintain it."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.13.7/Lertaro-Setup.exe#/setup.exe",
            "hash": "da588336879ae33edfa77091da7b6004b8ab621437a9bb86a43310abd64d3516"
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.13.7/Lertaro-Setup-arm64.exe#/setup.exe",
            "hash": "1da57c0c9c5e4bc9a15438ac5838c7a76e9dcf3a8ee31b0f3d3690a2fadb6601"
        }
    },
    "pre_install": "if (!$global -or !(is_admin)) { throw 'Use an administrator shell and scoop install --global lertaro/lertaro-np.' }",
    "installer": {
        "script": "if (!(Invoke-ExternalCommand \"$dir\\setup.exe\" -ArgumentList @('/SP-', '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', '/TASKS=startmenuicon,addtopath', \"/LOG=$dir\\install.log\") -RunAs)) { throw \"Lertaro installation failed. See $dir\\install.log.\" }"
    },
    "post_install": [
        "$registration = Get-ItemProperty -LiteralPath 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{D37D0B75-B5E3-40D9-92EE-429C7D4D7F2A}_is1' -ErrorAction Stop",
        "if ([string]::IsNullOrWhiteSpace($registration.InstallLocation)) { throw \"Lertaro InstallLocation is missing. See $dir\\install.log.\" }",
        "$required = @('Lertaro.Core.dll', 'Lertaro.PluginSdk.dll', 'Lertaro.Service.deps.json', 'System.ServiceProcess.ServiceController.dll')",
        "foreach ($name in @('Lertaro.App', 'Lertaro.Service', 'lff')) { $required += \"$name.exe\", \"$name.dll\", \"$name.runtimeconfig.json\" }",
        "foreach ($name in $required) {",
        "    $file = Join-Path $registration.InstallLocation $name",
        "    if (!(Test-Path -LiteralPath $file -PathType Leaf)) { throw \"Lertaro installation is incomplete: $file is missing. See $dir\\install.log.\" }",
        "}",
        "Write-Host \"Lertaro installed in $($registration.InstallLocation). Launch Lertaro.App.exe or use the Start menu.\""
    ],
    "uninstaller": {
        "script": [
            "# ponytail: use the stable installer directory; an upgrade must not uninstall the shared application or service.",
            "if ($cmd -eq 'uninstall') {",
            "    if (!$global -or !(is_admin)) { throw 'Use an administrator shell and scoop uninstall --global lertaro-np.' }",
            "    $registration = $null",
            "    try { $registration = Get-ItemProperty -LiteralPath 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{D37D0B75-B5E3-40D9-92EE-429C7D4D7F2A}_is1' -ErrorAction Stop } catch [System.Management.Automation.ItemNotFoundException] { }",
            "    if ($registration) {",
            "        if ([string]::IsNullOrWhiteSpace($registration.InstallLocation)) { throw 'Lertaro InstallLocation is missing.' }",
            "        $uninstaller = Join-Path $registration.InstallLocation 'unins000.exe'",
            "        if (!(Invoke-ExternalCommand $uninstaller -ArgumentList @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART') -RunAs)) { throw 'Lertaro uninstallation failed.' }",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup.exe#/setup.exe"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Setup-arm64.exe#/setup.exe"
            }
        }
    }
}
