<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lertaro.Core</AssemblyName>
    <RootNamespace>Lertaro.Core</RootNamespace>
    <Version>3.1.2</Version>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- IndexV2 reads its memory-mapped snapshot through typed spans over a raw view pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PluginSdk\PluginSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lertaro.Core.Tests" />
    <InternalsVisibleTo Include="Lertaro.App" />
    <InternalsVisibleTo Include="Lertaro.App.Tests" />
    <InternalsVisibleTo Include="Lertaro.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Services\LocalSend\MimeTypes.json" />
  </ItemGroup>

</Project>
