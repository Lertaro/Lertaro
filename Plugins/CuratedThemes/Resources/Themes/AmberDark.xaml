<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">AmberDark</sys:String>
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">1.0</sys:Double>

    <SolidColorBrush x:Key="CardBackground" Color="#2B1D08"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#4A3512"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F2E3C2"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#BFA06A"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#F0A83E"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#362509"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#4A3512"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#F0C24B"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#BFA06A"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#BFA06A"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#362509"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A3512"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#402C0B"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#2B1D08"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#4A3512"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#7C6538"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#4A3512"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#2B1D08"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#4A3512"/>
    <SolidColorBrush x:Key="MenuText" Color="#F2E3C2"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#7C6538"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#BFA06A"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#4A3512"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#201404"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#2B1D08"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#4A3512"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#3A280A"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#2B1D08"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#BFA06A"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#4A3512"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#170F03"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#362509"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#563C0F"/>
    <SolidColorBrush x:Key="SidebarText" Color="#F2E3C2"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#FBF3E0"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#F0A83E"/>
    <SolidColorBrush x:Key="ContentBg" Color="#201404"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#2B1D08"/>
    <SolidColorBrush x:Key="ItemHover" Color="#362509"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#563C0F"/>
    <SolidColorBrush x:Key="AccentBarColor" Color="#F0A83E"/>
    <SolidColorBrush x:Key="BorderColor" Color="#4A3512"/>
    <SolidColorBrush x:Key="AccentColor" Color="#F0A83E"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#F2E3C2"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#BFA06A"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#2B1D08"/>
    <SolidColorBrush x:Key="IconMutedBrush" Color="#BFA06A"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#7FC463"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F0C24B"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#3D3116"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#5C4A1F"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#563C0F"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#6E4D14"/>
    <SolidColorBrush x:Key="BadgeText" Color="#F2E3C2"/>
    <!-- Accent is a light amber (#F0A83E) rather than a mid-tone hue: white button text
         reads low-contrast on it, so this uses dark text like Nord's light-cyan accent does. -->
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#201404"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#F5BC6A"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#FAD69A"/>

    <SolidColorBrush x:Key="SecondaryButtonText" Color="#BFA06A"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#F2E3C2"/>

    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#16321A"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#24502B"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#7FC463"/>

    <SolidColorBrush x:Key="ErrorBackground" Color="#3A1A1A"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#5A2626"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#201404"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#2B1D08"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#7C6538"/>

    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Mapping of plugin hardcoded hex colors to dynamic theme brushes -->
    <SolidColorBrush x:Key="#333333" Color="#FBF3E0"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#FBF3E0"/>
    <SolidColorBrush x:Key="#333" Color="#FBF3E0"/>

    <SolidColorBrush x:Key="VideoIconColor" Color="#FB7185"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#C4B0FC"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#F0A83E"/>

    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#674812"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#7F5917"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#8A703E"/>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#E81123"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#4ADE80"/>

</ResourceDictionary>
