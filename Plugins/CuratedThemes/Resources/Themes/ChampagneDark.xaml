<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">ChampagneDark</sys:String>
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">1.0</sys:Double>

    <SolidColorBrush x:Key="CardBackground" Color="#241F12"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#423823"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#EFE7D2"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B3A47C"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#D4AF37"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#2E2716"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#423823"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#E0B23E"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#B3A47C"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#B3A47C"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#2E2716"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#423823"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#382F1B"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#241F12"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#423823"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#6F6142"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#423823"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#241F12"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#423823"/>
    <SolidColorBrush x:Key="MenuText" Color="#EFE7D2"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#6F6142"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#B3A47C"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#423823"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#1A160C"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#241F12"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#423823"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#332B18"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#241F12"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#B3A47C"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#423823"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#14110A"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#2E2716"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#4A3E1E"/>
    <SolidColorBrush x:Key="SidebarText" Color="#EFE7D2"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#FBF7EA"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#D4AF37"/>
    <SolidColorBrush x:Key="ContentBg" Color="#1A160C"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#241F12"/>
    <SolidColorBrush x:Key="ItemHover" Color="#2E2716"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#4A3E1E"/>
    <SolidColorBrush x:Key="AccentBarColor" Color="#D4AF37"/>
    <SolidColorBrush x:Key="BorderColor" Color="#423823"/>
    <SolidColorBrush x:Key="AccentColor" Color="#D4AF37"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#EFE7D2"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#B3A47C"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#241F12"/>
    <SolidColorBrush x:Key="IconMutedBrush" Color="#B3A47C"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#7FC463"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F0C24B"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#3D3116"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#5C4A1F"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#4A3E1E"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#5C4E28"/>
    <SolidColorBrush x:Key="BadgeText" Color="#EFE7D2"/>
    <!-- Accent is a light gold (#D4AF37) rather than a mid-tone hue: white button text
         reads low-contrast on it, so this uses dark text like Nord's light-cyan accent does. -->
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#1F1A0C"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#E0C158"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#ECD68A"/>

    <SolidColorBrush x:Key="SecondaryButtonText" Color="#B3A47C"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#EFE7D2"/>

    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#16321A"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#24502B"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#7FC463"/>

    <SolidColorBrush x:Key="ErrorBackground" Color="#3A1A1A"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#5A2626"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#1A160C"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#241F12"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#6F6142"/>

    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Mapping of plugin hardcoded hex colors to dynamic theme brushes -->
    <SolidColorBrush x:Key="#333333" Color="#FBF7EA"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#FBF7EA"/>
    <SolidColorBrush x:Key="#333" Color="#FBF7EA"/>

    <SolidColorBrush x:Key="VideoIconColor" Color="#FB7185"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#C4B0FC"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#D4AF37"/>

    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#594A24"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#6A5A2E"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#7C6C4A"/>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#E81123"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#4ADE80"/>

</ResourceDictionary>
