<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">IndigoDark</sys:String>
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">1.0</sys:Double>

    <SolidColorBrush x:Key="CardBackground" Color="#161233"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2E2A5C"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#E3E1FA"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9C97CC"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#818CF8"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#1F1A47"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2E2A5C"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#F0A93E"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#9C97CC"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#9C97CC"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#1F1A47"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#2E2A5C"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#251F52"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#161233"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#2E2A5C"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#5D5892"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#2E2A5C"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#161233"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#2E2A5C"/>
    <SolidColorBrush x:Key="MenuText" Color="#E3E1FA"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#5D5892"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#9C97CC"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#2E2A5C"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#0E0B24"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#161233"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#2E2A5C"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#201A47"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#161233"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#9C97CC"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#2E2A5C"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#0A0820"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#1F1A47"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#322B6E"/>
    <SolidColorBrush x:Key="SidebarText" Color="#E3E1FA"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#F8F7FE"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#818CF8"/>
    <SolidColorBrush x:Key="ContentBg" Color="#0E0B24"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#161233"/>
    <SolidColorBrush x:Key="ItemHover" Color="#1F1A47"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#322B6E"/>
    <SolidColorBrush x:Key="AccentBarColor" Color="#818CF8"/>
    <SolidColorBrush x:Key="BorderColor" Color="#2E2A5C"/>
    <SolidColorBrush x:Key="AccentColor" Color="#818CF8"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#E3E1FA"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#9C97CC"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#161233"/>
    <SolidColorBrush x:Key="IconMutedBrush" Color="#9C97CC"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#3A2E10"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#5C4A1A"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#322D68"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#423C82"/>
    <SolidColorBrush x:Key="BadgeText" Color="#E3E1FA"/>
    <!-- Accent is a light periwinkle (#818CF8) rather than a mid-tone hue: white button text
         reads low-contrast on it, so this uses dark text like Nord's light-cyan accent does. -->
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#14102E"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#6C74EF"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#A5ABF9"/>

    <SolidColorBrush x:Key="SecondaryButtonText" Color="#9C97CC"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#E3E1FA"/>

    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#113322"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#1D4E32"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#4ADE80"/>

    <SolidColorBrush x:Key="ErrorBackground" Color="#3A1A1A"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#5A2626"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#0E0B24"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#161233"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#5D5892"/>

    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Mapping of plugin hardcoded hex colors to dynamic theme brushes -->
    <SolidColorBrush x:Key="#333333" Color="#F8F7FE"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#F8F7FE"/>
    <SolidColorBrush x:Key="#333" Color="#F8F7FE"/>

    <SolidColorBrush x:Key="VideoIconColor" Color="#FB7185"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#C084FC"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#818CF8"/>

    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#413B88"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#524AA1"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#746FA8"/>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#E81123"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#34D399"/>

</ResourceDictionary>
