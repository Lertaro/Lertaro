<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">MintDark</sys:String>
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">1.0</sys:Double>

    <SolidColorBrush x:Key="CardBackground" Color="#0F241B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1F4536"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#D6F5E8"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#86BFA9"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#143327"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1F4536"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#F0A93E"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#86BFA9"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#86BFA9"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#143327"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#1F4536"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#18402F"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#0F241B"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#1F4536"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#4E7E6C"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#1F4536"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#0F241B"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#1F4536"/>
    <SolidColorBrush x:Key="MenuText" Color="#D6F5E8"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#4E7E6C"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#86BFA9"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#1F4536"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#071410"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#0F241B"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#1F4536"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#163429"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#0F241B"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#86BFA9"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#1F4536"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#081A13"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#143327"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#1C5240"/>
    <SolidColorBrush x:Key="SidebarText" Color="#D6F5E8"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#F0FDF8"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="ContentBg" Color="#071410"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#0F241B"/>
    <SolidColorBrush x:Key="ItemHover" Color="#143327"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#1C5240"/>
    <SolidColorBrush x:Key="AccentBarColor" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#1F4536"/>
    <SolidColorBrush x:Key="AccentColor" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#D6F5E8"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#86BFA9"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#0F241B"/>
    <SolidColorBrush x:Key="IconMutedBrush" Color="#86BFA9"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#3A2E10"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#5C4A1A"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#204939"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#2C5F4C"/>
    <SolidColorBrush x:Key="BadgeText" Color="#D6F5E8"/>
    <!-- Accent is a light teal (#2DD4BF) rather than a mid-tone hue: white button text
         reads low-contrast on it, so this uses dark text like Nord's light-cyan accent does. -->
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#062017"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#4FE0CC"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#8FEEDF"/>

    <SolidColorBrush x:Key="SecondaryButtonText" Color="#86BFA9"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#D6F5E8"/>

    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#113322"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#1D4E32"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#4ADE80"/>

    <SolidColorBrush x:Key="ErrorBackground" Color="#3A1A1A"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#5A2626"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#071410"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#0F241B"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#4E7E6C"/>

    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Mapping of plugin hardcoded hex colors to dynamic theme brushes -->
    <SolidColorBrush x:Key="#333333" Color="#F0FDF8"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#F0FDF8"/>
    <SolidColorBrush x:Key="#333" Color="#F0FDF8"/>

    <SolidColorBrush x:Key="VideoIconColor" Color="#FB7185"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#A78BFA"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#2DD4BF"/>

    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#285B47"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#34705A"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#588E7A"/>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#E81123"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#4ADE80"/>

</ResourceDictionary>
