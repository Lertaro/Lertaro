<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">AmethystDark</sys:String>
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">1.0</sys:Double>

    <SolidColorBrush x:Key="CardBackground" Color="#201730"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#392A50"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#E8E1F5"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A796C2"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#A78BFA"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#291D3D"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#392A50"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#F0A93E"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#A796C2"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#A796C2"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#291D3D"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#392A50"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#302448"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#201730"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#392A50"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#6B5C87"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#392A50"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#201730"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#392A50"/>
    <SolidColorBrush x:Key="MenuText" Color="#E8E1F5"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#6B5C87"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#A796C2"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#392A50"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#170F26"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#201730"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#392A50"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#2A1F3F"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#201730"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#A796C2"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#392A50"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#130B20"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#291D3D"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#402A5C"/>
    <SolidColorBrush x:Key="SidebarText" Color="#E8E1F5"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#F7F3FD"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#A78BFA"/>
    <SolidColorBrush x:Key="ContentBg" Color="#170F26"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#201730"/>
    <SolidColorBrush x:Key="ItemHover" Color="#291D3D"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#402A5C"/>
    <SolidColorBrush x:Key="AccentBarColor" Color="#A78BFA"/>
    <SolidColorBrush x:Key="BorderColor" Color="#392A50"/>
    <SolidColorBrush x:Key="AccentColor" Color="#A78BFA"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#E8E1F5"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#A796C2"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#201730"/>
    <SolidColorBrush x:Key="IconMutedBrush" Color="#A796C2"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#3A2E10"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#5C4A1A"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#40325A"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#50406E"/>
    <SolidColorBrush x:Key="BadgeText" Color="#E8E1F5"/>
    <!-- Accent is a light violet (#A78BFA) rather than a mid-tone hue: white button text
         reads low-contrast on it, so this uses dark text like Nord's light-cyan accent does. -->
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#1B1129"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#C4B0FC"/>

    <SolidColorBrush x:Key="SecondaryButtonText" Color="#A796C2"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#E8E1F5"/>

    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#113322"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#1D4E32"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#4ADE80"/>

    <SolidColorBrush x:Key="ErrorBackground" Color="#3A1A1A"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#5A2626"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#170F26"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#201730"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#6B5C87"/>

    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Mapping of plugin hardcoded hex colors to dynamic theme brushes -->
    <SolidColorBrush x:Key="#333333" Color="#F7F3FD"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#F7F3FD"/>
    <SolidColorBrush x:Key="#333" Color="#F7F3FD"/>

    <SolidColorBrush x:Key="VideoIconColor" Color="#FB7185"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#C4B0FC"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#A78BFA"/>

    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#503F71"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#604D85"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#7C6C9B"/>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#E81123"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#34D399"/>

</ResourceDictionary>
