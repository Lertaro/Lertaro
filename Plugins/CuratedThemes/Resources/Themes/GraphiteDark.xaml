<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">GraphiteDark</sys:String>
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">1.0</sys:Double>

    <SolidColorBrush x:Key="CardBackground" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#7B93A8"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#232323"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#333333"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#E0A73E"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#232323"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#333333"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="MenuText" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#333333"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#121212"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#262626"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#0E0E0E"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#232323"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#2E3A45"/>
    <SolidColorBrush x:Key="SidebarText" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#7B93A8"/>
    <SolidColorBrush x:Key="ContentBg" Color="#121212"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="ItemHover" Color="#232323"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#2E3A45"/>
    <SolidColorBrush x:Key="AccentBarColor" Color="#7B93A8"/>
    <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
    <SolidColorBrush x:Key="AccentColor" Color="#7B93A8"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="IconMutedBrush" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#3A2E10"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#5C4A1A"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="BadgeText" Color="#E4E4E4"/>
    <!-- Accent is a light steel-blue (#7B93A8) rather than a mid-tone hue: white button text
         reads low-contrast on it, so this uses dark text like Nord's light-cyan accent does. -->
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#10151A"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#6E8598"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#9CB1C2"/>

    <SolidColorBrush x:Key="SecondaryButtonText" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#E4E4E4"/>

    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#113322"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#1D4E32"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#4ADE80"/>

    <SolidColorBrush x:Key="ErrorBackground" Color="#3A1A1A"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#5A2626"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#121212"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#5C5C5C"/>

    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Mapping of plugin hardcoded hex colors to dynamic theme brushes -->
    <SolidColorBrush x:Key="#333333" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="#333" Color="#FAFAFA"/>

    <SolidColorBrush x:Key="VideoIconColor" Color="#FB7185"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#A78BFA"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#7B93A8"/>

    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#474747"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#575757"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#696969"/>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#E81123"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#34D399"/>

</ResourceDictionary>
