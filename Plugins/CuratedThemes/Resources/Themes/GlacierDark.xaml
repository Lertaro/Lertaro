<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">GlacierDark</sys:String>
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">1.0</sys:Double>

    <SolidColorBrush x:Key="CardBackground" Color="#121D2B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#22344A"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#DCE6F0"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8FA3B8"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#38BDF8"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#17263A"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#22344A"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#F5A623"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#8FA3B8"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#8FA3B8"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#17263A"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#22344A"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#1D2E45"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#121D2B"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#22344A"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#4C5F73"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#22344A"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#121D2B"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#22344A"/>
    <SolidColorBrush x:Key="MenuText" Color="#DCE6F0"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#4C5F73"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#8FA3B8"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#22344A"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#0B1420"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#121D2B"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#22344A"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#1B2A3D"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#121D2B"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#8FA3B8"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#22344A"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#0E1826"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#17263A"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#123655"/>
    <SolidColorBrush x:Key="SidebarText" Color="#DCE6F0"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#38BDF8"/>
    <SolidColorBrush x:Key="ContentBg" Color="#0B1420"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#121D2B"/>
    <SolidColorBrush x:Key="ItemHover" Color="#17263A"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#123655"/>
    <SolidColorBrush x:Key="AccentBarColor" Color="#38BDF8"/>
    <SolidColorBrush x:Key="BorderColor" Color="#22344A"/>
    <SolidColorBrush x:Key="AccentColor" Color="#38BDF8"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#DCE6F0"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#8FA3B8"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#121D2B"/>
    <SolidColorBrush x:Key="IconMutedBrush" Color="#8FA3B8"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#3A2E10"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#5C4A1A"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#2C3E52"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#3A4F66"/>
    <SolidColorBrush x:Key="BadgeText" Color="#DCE6F0"/>
    <!-- Accent is a light sky-blue (#38BDF8) rather than a mid-tone blue: white button text
         reads low-contrast on it, so this uses dark navy text like Nord's light-cyan accent does. -->
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#08131F"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#7DD3FC"/>

    <SolidColorBrush x:Key="SecondaryButtonText" Color="#8FA3B8"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#DCE6F0"/>

    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#113322"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#1D4E32"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#4ADE80"/>

    <SolidColorBrush x:Key="ErrorBackground" Color="#3A1A1A"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#5A2626"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#0B1420"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#121D2B"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#4C5F73"/>

    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Mapping of plugin hardcoded hex colors to dynamic theme brushes -->
    <SolidColorBrush x:Key="#333333" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="#333" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="VideoIconColor" Color="#FB7185"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#A78BFA"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#38BDF8"/>

    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#354B63"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#435C76"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#566C82"/>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#E81123"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#34D399"/>

</ResourceDictionary>
