<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">TerracottaDark</sys:String>
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">1.0</sys:Double>

    <SolidColorBrush x:Key="CardBackground" Color="#241C15"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3D2E22"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#EFE0D2"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B29A83"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#E08A4B"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#2E2318"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#3D2E22"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#F0A93E"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#B29A83"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#B29A83"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#2E2318"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3D2E22"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#38291B"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#241C15"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#3D2E22"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#6E5A46"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#3D2E22"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#241C15"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#3D2E22"/>
    <SolidColorBrush x:Key="MenuText" Color="#EFE0D2"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#6E5A46"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#B29A83"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#3D2E22"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#1B140F"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#241C15"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#3D2E22"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#332619"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#241C15"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#B29A83"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3D2E22"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#17110C"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#2E2318"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#4A2F1A"/>
    <SolidColorBrush x:Key="SidebarText" Color="#EFE0D2"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#FFF3E6"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#E08A4B"/>
    <SolidColorBrush x:Key="ContentBg" Color="#1B140F"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#241C15"/>
    <SolidColorBrush x:Key="ItemHover" Color="#2E2318"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#4A2F1A"/>
    <SolidColorBrush x:Key="AccentBarColor" Color="#E08A4B"/>
    <SolidColorBrush x:Key="BorderColor" Color="#3D2E22"/>
    <SolidColorBrush x:Key="AccentColor" Color="#E08A4B"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#EFE0D2"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#B29A83"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#241C15"/>
    <SolidColorBrush x:Key="IconMutedBrush" Color="#B29A83"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#7FC463"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F0C24B"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#3D3116"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#5C4A1F"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#4A3B2A"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#5C4A36"/>
    <SolidColorBrush x:Key="BadgeText" Color="#EFE0D2"/>
    <!-- Accent is a light warm orange (#E08A4B) rather than a mid-tone hue: white button text
         reads low-contrast on it, so this uses dark text like Nord's light-cyan accent does. -->
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#1F150C"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#E9A165"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#F0B685"/>

    <SolidColorBrush x:Key="SecondaryButtonText" Color="#B29A83"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#EFE0D2"/>

    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#1C2E17"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#2E4926"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#7FC463"/>

    <SolidColorBrush x:Key="ErrorBackground" Color="#3A1D16"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#5A2E22"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F1734C"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#1B140F"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#241C15"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#6E5A46"/>

    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Mapping of plugin hardcoded hex colors to dynamic theme brushes -->
    <SolidColorBrush x:Key="#333333" Color="#FFF3E6"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#FFF3E6"/>
    <SolidColorBrush x:Key="#333" Color="#FFF3E6"/>

    <SolidColorBrush x:Key="VideoIconColor" Color="#F0577A"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#B78BE0"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#E08A4B"/>

    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#574531"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#69543E"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#7A644E"/>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#E81123"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#4ADE80"/>

</ResourceDictionary>
