<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lertaro.Plugins.Tessoa</AssemblyName>
    <Version>1.0.0</Version>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../PluginSdk/PluginSdk.csproj" Private="false" />
    <InternalsVisibleTo Include="Lertaro.Plugins.Tessoa.Tests" />
    <EmbeddedResource Include="Resources/Translations/**/*.json" />
    <AssemblyMetadata Include="Lertaro.Plugin.Name" Value="tessoa" />
    <AssemblyMetadata Include="Lertaro.Plugin.DescriptionKey" Value="Tessoa_Description" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="../../App/bin/$(Configuration)/$(TargetFramework)/Plugins/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="../../Service/bin/$(Configuration)/$(TargetFramework)/Plugins/" SkipUnchangedFiles="true" />
  </Target>
</Project>
