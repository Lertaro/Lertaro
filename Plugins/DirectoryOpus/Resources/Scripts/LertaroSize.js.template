// Lertaro Directory Opus script integration. This file is managed by Lertaro.
var LertaroSizeLabel = "{{LABEL}}";
var LertaroSizeDescription = "{{DESCRIPTION}}";
var LertaroCliPath = "{{LFF_PATH}}";
var LertaroSizeCache = {};
var LertaroSizeCacheLifetimeMs = 1000;
var LertaroSizeLastError = "";

function OnInit(initData) {
    initData.name = LertaroSizeLabel;
    initData.desc = LertaroSizeDescription;
    initData.version = "1.0";
    initData.default_enable = true;
}

function OnAddColumns(addColData) {
    var column = addColData.AddColumn();
    column.name = "LertaroSize";
    column.label = LertaroSizeLabel;
    column.header = LertaroSizeLabel;
    column.method = "OnLertaroSize";
    column.type = "size";
    column.justify = "right";
    column.autorefresh = true;
    column.namerefresh = true;
}

function OnLertaroSize(scriptColData) {
    var item = scriptColData.item;
    if (!item.is_dir) {
        scriptColData.value = item.size;
        return;
    }

    var itemPath = NormalizePath(String(item.realpath));
    var parentPath = NormalizePath(String(item.path));
    var sizes = GetFolderSizes(parentPath);
    var size = sizes[NormalizePath(itemPath)];
    if (typeof size != "undefined")
        scriptColData.value = DOpus.FSUtil.NewFileSize(size);
}

function OnBeforeFolderChange(beforeFolderChangeData) {
    var path = NormalizePath(String(beforeFolderChangeData.path));
    delete LertaroSizeCache[path];
}

function GetFolderSizes(directory) {
    var key = NormalizePath(directory);
    var cached = LertaroSizeCache[key];
    if (typeof cached != "undefined" && cached.expires > new Date().getTime())
        return cached.sizes;

    var sizes = {};
    try {
        var result = DOpus.FSUtil.Run(QuoteArgument(LertaroCliPath) + " --space-entries " + QuoteArgument(directory), 0, "r");
        if (result && result.exitcode == 0) {
            var entries = JSON.parse(result.stdout);
            for (var i = 0; i < entries.length; i++)
                sizes[NormalizePath(entries[i].Path)] = entries[i].Size;
            LertaroSizeLastError = "";
        }
        else
            ReportError(ReadRunError(result));
    }
    catch (error) { ReportError(error); }

    LertaroSizeCache[key] = { sizes: sizes, expires: new Date().getTime() + LertaroSizeCacheLifetimeMs };
    return sizes;
}

function ReportError(error) {
    var message = String(error.description || error.message || error);
    if (message == LertaroSizeLastError)
        return;
    LertaroSizeLastError = message;
    DOpus.Output("Lertaro Size: " + message, true);
}

function ReadRunError(result) {
    if (!result)
        return "Could not start lff.";
    var message = String(result.stderr).replace(/^\s+|\s+$/g, "");
    return message.length == 0 ? "lff exited with code " + result.exitcode + "." : message;
}

function NormalizePath(path) {
    var normalized = String(path).replace(/\//g, "\\").toLowerCase();
    if (/^[a-z]:$/i.test(normalized))
        return normalized + "\\";
    while (normalized.length > 3 && normalized.charAt(normalized.length - 1) == "\\")
        normalized = normalized.substring(0, normalized.length - 1);
    return normalized;
}

function QuoteArgument(value) {
    return "\"" + String(value).replace(/\"/g, "\"\"") + "\"";
}
