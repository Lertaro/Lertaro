<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">SakuraBloom</sys:String>
    <sys:Boolean x:Key="IsDark">False</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">0.95</sys:Double>

    <!-- Animated Visual Brush for Sakura Bloom (Self-Contained Petal Triggers) -->
    <VisualBrush x:Key="ContentBg" TileMode="None" Stretch="Fill">
        <VisualBrush.Visual>
            <Grid Width="800" Height="600" ClipToBounds="True">
                <!-- Base Radial Background -->
                <Grid.Background>
                    <RadialGradientBrush Center="0.85,0.15" GradientOrigin="0.85,0.15" RadiusX="1.2" RadiusY="1.2">
                        <GradientStop Color="#FFFFF5F7" Offset="0.0"/>
                        <GradientStop Color="#FFFFE5EC" Offset="0.6"/>
                        <GradientStop Color="#FFF0C2D1" Offset="1.0"/>
                    </RadialGradientBrush>
                </Grid.Background>

                <!-- Sakura Petals Canvas -->
                <Canvas ClipToBounds="True">
                    <!-- Petal 1 -->
                    <Path Data="M 0,0 C 5,-10 15,-10 20,-5 C 20,5 10,15 0,20 C -5,10 -5,5 0,0 Z" Fill="#80FFB7C5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                <RotateTransform Angle="0" CenterX="10" CenterY="10"/>
                                <TranslateTransform X="150" Y="-30"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.SizeChanged">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.Y)"
                                                         From="-50" To="650" Duration="0:0:12" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.X)"
                                                         From="100" To="280" Duration="0:0:12" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:12" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>

                    <!-- Petal 2 -->
                    <Path Data="M 0,0 C 5,-10 15,-10 20,-5 C 20,5 10,15 0,20 C -5,10 -5,5 0,0 Z" Fill="#A0FFC2D1">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                <RotateTransform Angle="45" CenterX="10" CenterY="10"/>
                                <TranslateTransform X="400" Y="-30"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.SizeChanged">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.Y)"
                                                         From="-50" To="650" Duration="0:0:15" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.X)"
                                                         From="400" To="550" Duration="0:0:15" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)"
                                                         From="45" To="405" Duration="0:0:15" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>

                    <!-- Petal 3 -->
                    <Path Data="M 0,0 C 5,-10 15,-10 20,-5 C 20,5 10,15 0,20 C -5,10 -5,5 0,0 Z" Fill="#60FFB7C5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                                <RotateTransform Angle="120" CenterX="10" CenterY="10"/>
                                <TranslateTransform X="650" Y="-30"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.SizeChanged">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.Y)"
                                                         From="-50" To="650" Duration="0:0:10" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.X)"
                                                         From="600" To="720" Duration="0:0:10" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)"
                                                         From="120" To="-240" Duration="0:0:10" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>

                    <!-- Petal 4 -->
                    <Path Data="M 0,0 C 5,-10 15,-10 20,-5 C 20,5 10,15 0,20 C -5,10 -5,5 0,0 Z" Fill="#90FFE5EC">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                <RotateTransform Angle="80" CenterX="10" CenterY="10"/>
                                <TranslateTransform X="280" Y="-50"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.SizeChanged">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.Y)"
                                                         From="-50" To="650" Duration="0:0:18" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(TranslateTransform.X)"
                                                         From="250" To="420" Duration="0:0:18" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)"
                                                         From="80" To="440" Duration="0:0:18" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                </Canvas>
            </Grid>
        </VisualBrush.Visual>
    </VisualBrush>

    <LinearGradientBrush x:Key="HeaderBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE5EC" Offset="0.0"/>
        <GradientStop Color="#FFF0F3" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarBg" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFF0F3" Offset="0.0"/>
        <GradientStop Color="#FFE5EC" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Alpha raised from CC (80%) to E6 (90%): keeps the soft translucent card feel while giving
         body text a more reliably opaque backing against whatever's on the real desktop behind it
         (this window is AllowsTransparency=True). -->
    <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFFDFE" Offset="0.0"/>
        <GradientStop Color="#E6FFE5EC" Offset="1.0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CardBorderBrush" Color="#80FFC2D1"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#4C1E30"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8C536B"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#FF6B8B"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#FFE5EC"/>
    <!-- Dedicated accent-bar color: this theme's row-selection tint (#FFC2D1) is nearly identical to
         its hover fill (#FFE5EC), so a thin bar in that color washes out. Reuses SidebarAccent instead. -->
    <SolidColorBrush x:Key="AccentBarColor" Color="#FF6B8B"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FFD6E0"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#FF6B8B"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#8C536B"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#8C536B"/>

    <LinearGradientBrush x:Key="ControlBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFDFE" Offset="0.0"/>
        <GradientStop Color="#FFF0F3" Offset="1.0"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFD6E0"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#FFE5EC"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#FFFDFE"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#FFF0F2"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#D0B0BC"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#FFD6E0"/>
    
    <LinearGradientBrush x:Key="MenuBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF5F7" Offset="0.0"/>
        <GradientStop Color="#FFFDFE" Offset="1.0"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#FFD6E0"/>
    <SolidColorBrush x:Key="MenuText" Color="#4C1E30"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#D0B0BC"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#FF6B8B"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#FFE5EC"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#FFE5EC"/>
    
    <LinearGradientBrush x:Key="SettingsCardBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9FFFDFE" Offset="0.0"/>
        <GradientStop Color="#D9FFF0F3" Offset="1.0"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#FFD6E0"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#FFF5F7"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#FFE5EC"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#8C536B"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#FFFFB7C5"/>
    
    <SolidColorBrush x:Key="SidebarHover" Color="#FFE5EC"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#FFC2D1"/>
    <SolidColorBrush x:Key="SidebarText" Color="#8C536B"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#4C1E30"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#FF6B8B"/>
    <SolidColorBrush x:Key="ItemHover" Color="#FFE5EC"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#FFC2D1"/>
    <SolidColorBrush x:Key="BorderColor" Color="#FFD6E0"/>
    <SolidColorBrush x:Key="AccentColor" Color="#FF6B8B"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#4C1E30"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#8C536B"/>
    
    <LinearGradientBrush x:Key="StatusBarBg" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFE5EC" Offset="0.0"/>
        <GradientStop Color="#FFF0F3" Offset="1.0"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="IconMutedBrush" Color="#8C536B"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF6B8B"/>
    <!-- #FFA07A was nearly as light as WarningBackground below (#FFF5EE), making warning text
         hard to read; darkened toward the theme's own coral while keeping the warm hue. -->
    <SolidColorBrush x:Key="WarningBrush" Color="#D9754F"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#FFF5EE"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FFE4E1"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#FFE5EC"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#FFD6E0"/>
    <SolidColorBrush x:Key="BadgeText" Color="#FF6B8B"/>
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#FFFFFF"/>
    
    <LinearGradientBrush x:Key="PrimaryButtonHoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFC2D1" Offset="0.0"/>
        <GradientStop Color="#FFFF6B8B" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonPressedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFF6B8B" Offset="0.0"/>
        <GradientStop Color="#FFE05B77" Offset="1.0"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="SecondaryButtonText" Color="#8C536B"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#4C1E30"/>

    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#FFF5F7"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#FFD6E0"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#FF6B8B"/>
    
    <SolidColorBrush x:Key="ErrorBackground" Color="#FFF0F2"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FFE4E8"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF4D6D"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#FFFDFE"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#FFD6E0"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#D0B0BC"/>

    <Color x:Key="ShadowColor">#FFFF8DA1</Color>

    <!-- Mappings -->
    <SolidColorBrush x:Key="#333333" Color="#4C1E30"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#4C1E30"/>
    <SolidColorBrush x:Key="#333" Color="#4C1E30"/>

    <SolidColorBrush x:Key="VideoIconColor" Color="#FF6B8B"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#E58B88"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#FF8DA1"/>

    <LinearGradientBrush x:Key="ScrollBarThumbBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFC0CC" Offset="0.0"/>
        <GradientStop Color="#FFFFADBD" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollBarThumbHover" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFADBD" Offset="0.0"/>
        <GradientStop Color="#FFFF8399" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollBarThumbDragging" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFF8399" Offset="0.0"/>
        <GradientStop Color="#FFFF5476" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#FF5E7E"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#FF6B8B"/>

</ResourceDictionary>
