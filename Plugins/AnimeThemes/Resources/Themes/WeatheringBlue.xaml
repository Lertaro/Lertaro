<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">WeatheringBlue</sys:String>
    <sys:Boolean x:Key="IsDark">False</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">0.95</sys:Double>

    <!-- Animated Visual Brush for Weathering Blue (Self-Contained Cloud Triggers) -->
    <VisualBrush x:Key="ContentBg" TileMode="None" Stretch="Fill">
        <VisualBrush.Visual>
            <Grid Width="800" Height="600" ClipToBounds="True">
                <!-- Base Radial Blue Sky/Sunshine Background -->
                <Grid.Background>
                    <RadialGradientBrush Center="0.15,0.15" GradientOrigin="0.15,0.15" RadiusX="1.3" RadiusY="1.3">
                        <GradientStop Color="#FFFFFDF2" Offset="0.0"/>
                        <GradientStop Color="#FFE8F1F7" Offset="0.5"/>
                        <GradientStop Color="#FFC4E1F6" Offset="1.0"/>
                    </RadialGradientBrush>
                </Grid.Background>

                <!-- Clouds Canvas -->
                <Canvas ClipToBounds="True">
                    <!-- Cloud 1 -->
                    <Ellipse Width="260" Height="110">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.6" RadiusY="0.6">
                                <GradientStop Color="#D5FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#95D5E7F3" Offset="0.5"/>
                                <GradientStop Color="#00A5C2DE" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-150" Y="40"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.SizeChanged">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-150" To="850" Duration="0:0:20" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <!-- Cloud 2 -->
                    <Ellipse Width="200" Height="90">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.6" RadiusY="0.6">
                                <GradientStop Color="#C5FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#85C1DCF0" Offset="0.5"/>
                                <GradientStop Color="#009EB2C7" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-100" Y="250"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.SizeChanged">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-100" To="850" Duration="0:0:28" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <!-- Cloud 3 -->
                    <Ellipse Width="300" Height="130">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.6" RadiusY="0.6">
                                <GradientStop Color="#E0FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#90D5E7F3" Offset="0.5"/>
                                <GradientStop Color="#00A5C2DE" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-200" Y="380"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.SizeChanged">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-200" To="850" Duration="0:0:36" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Canvas>
            </Grid>
        </VisualBrush.Visual>
    </VisualBrush>

    <LinearGradientBrush x:Key="HeaderBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFD4E6F4" Offset="0.0"/>
        <GradientStop Color="#FFE8F1F7" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarBg" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFE8F1F7" Offset="0.0"/>
        <GradientStop Color="#FFD4E6F4" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Alpha raised from CC (80%) to E6 (90%): keeps the soft translucent card feel while giving
         body text a more reliably opaque backing against whatever's on the real desktop behind it
         (this window is AllowsTransparency=True). -->
    <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFFFFF" Offset="0.0"/>
        <GradientStop Color="#E6EDF5FA" Offset="1.0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CardBorderBrush" Color="#808FC6EC"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FF0F2E4A"/> <!-- Deep Blue Sea -->
    <SolidColorBrush x:Key="TextSecondary" Color="#FF5C82A6"/> <!-- Raincloud Gray-Blue -->
    <SolidColorBrush x:Key="AccentBlue" Color="#FF00A3E0"/> <!-- Sunshine Sky Blue -->
    <SolidColorBrush x:Key="HoverBackground" Color="#FFD5E7F3"/>
    <!-- Dedicated accent-bar color: this theme's row-selection tint (#BAD7EC) is nearly identical to
         its hover fill (#D5E7F3), so a thin bar in that color washes out. Reuses SidebarAccent instead. -->
    <SolidColorBrush x:Key="AccentBarColor" Color="#FF00A3E0"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FFBAD7EC"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#FFFAD02C"/> <!-- Sunlight Yellow -->
    <SolidColorBrush x:Key="FileIconColor" Color="#FF5C82A6"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#FF5C82A6"/>

    <LinearGradientBrush x:Key="ControlBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
        <GradientStop Color="#FFF4F9FC" Offset="1.0"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFBAD7EC"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#FFD5E7F3"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#FFF4F9FC"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#FFE8F1F6"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#FF9EB2C7"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#FFBAD7EC"/>
    
    <LinearGradientBrush x:Key="MenuBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF4F9FC" Offset="0.0"/>
        <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#FFBAD7EC"/>
    <SolidColorBrush x:Key="MenuText" Color="#FF0F2E4A"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#FF9EB2C7"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#FF5C82A6"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#FFD5E7F3"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#FFD5E7F3"/>
    
    <LinearGradientBrush x:Key="SettingsCardBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9FFFFFF" Offset="0.0"/>
        <GradientStop Color="#D9F4F9FC" Offset="1.0"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#FFBAD7EC"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#FFF4F9FC"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#FFD5E7F3"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#FF5C82A6"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#FF8EC6EC"/>
    
    <SolidColorBrush x:Key="SidebarHover" Color="#FFD5E7F3"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#FFBAD7EC"/>
    <SolidColorBrush x:Key="SidebarText" Color="#FF5C82A6"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#FF0F2E4A"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#FF00A3E0"/>
    <SolidColorBrush x:Key="ItemHover" Color="#FFD5E7F3"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#FFBAD7EC"/>
    <SolidColorBrush x:Key="BorderColor" Color="#FFBAD7EC"/>
    <SolidColorBrush x:Key="AccentColor" Color="#FF00A3E0"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#FF0F2E4A"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#FF5C82A6"/>
    
    <LinearGradientBrush x:Key="StatusBarBg" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFE8F1F7" Offset="0.0"/>
        <GradientStop Color="#FFD4E6F4" Offset="1.0"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="IconMutedBrush" Color="#FF5C82A6"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF00A3E0"/>
    <!-- #FFFAE02C was nearly as light as WarningBackground below (#FFFFFDF5), making warning text
         hard to read; darkened to a legible gold while staying in the theme's "sunshine" hue. -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB98A12"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#FFFFFDF5"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FFFFF3CD"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#FFD5E7F3"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#FFBAD7EC"/>
    <SolidColorBrush x:Key="BadgeText" Color="#FF00A3E0"/>
    
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#FFFFFFFF"/>
    <LinearGradientBrush x:Key="PrimaryButtonHoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF5CD2FF" Offset="0.0"/>
        <GradientStop Color="#FF00A3E0" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonPressedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF00A3E0" Offset="0.0"/>
        <GradientStop Color="#FF007AB8" Offset="1.0"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="SecondaryButtonText" Color="#FF5C82A6"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#FF0F2E4A"/>

    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#FFF4F9FC"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#FFBAD7EC"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#FF00A3E0"/>
    
    <SolidColorBrush x:Key="ErrorBackground" Color="#FFFDF2F4"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FFFCD6DD"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF4D6D"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#FFF5FAFD"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#FFBAD7EC"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#FF9EB2C7"/>

    <Color x:Key="ShadowColor">#FF00A3E0</Color>

    <!-- Mappings -->
    <SolidColorBrush x:Key="#333333" Color="#FF0F2E4A"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#FF0F2E4A"/>
    <SolidColorBrush x:Key="#333" Color="#FF0F2E4A"/>

    <SolidColorBrush x:Key="VideoIconColor" Color="#FF00A3E0"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#FF7BB2E0"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#FF00A3E0"/>

    <LinearGradientBrush x:Key="ScrollBarThumbBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFB1CBE2" Offset="0.0"/>
        <GradientStop Color="#FF9ABADA" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollBarThumbHover" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF9ABADA" Offset="0.0"/>
        <GradientStop Color="#FF84A9D2" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollBarThumbDragging" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF84A9D2" Offset="0.0"/>
        <GradientStop Color="#FF567A9D" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#FFFF5B7F"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#FF00A3E0"/>

</ResourceDictionary>
