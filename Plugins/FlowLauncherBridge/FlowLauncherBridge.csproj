<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lertaro.Plugins.FlowLauncherBridge</AssemblyName>
    <RootNamespace>Lertaro.Plugins.FlowLauncherBridge</RootNamespace>
    <Version>1.0.2</Version>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Flow.Launcher.Plugin\**" />
    <EmbeddedResource Remove="Flow.Launcher.Plugin\**" />
    <None Remove="Flow.Launcher.Plugin\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PluginSdk\PluginSdk.csproj" Private="false" />
    <ProjectReference Include="Flow.Launcher.Plugin\Flow.Launcher.Plugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lertaro.Plugins.FlowLauncherBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Translations\**\*.json" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <FlowBridgeOutput Include="$(TargetDir)$(TargetName).dll" Condition="Exists('$(TargetDir)$(TargetName).dll')" />
      <FlowBridgeOutput Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <FlowBridgeOutput Include="$(TargetDir)Flow.Launcher.Plugin.dll" Condition="Exists('$(TargetDir)Flow.Launcher.Plugin.dll')" />
      <FlowBridgeOutput Include="$(TargetDir)Flow.Launcher.Plugin.pdb" Condition="Exists('$(TargetDir)Flow.Launcher.Plugin.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(FlowBridgeOutput)" DestinationFolder="$(TargetDir)$(AssemblyName)\" SkipUnchangedFiles="true" />
    <Delete Files="@(FlowBridgeOutput)" Condition="$([System.IO.Path]::IsPathRooted('$(OutputPath)'))" />
    <ItemGroup>
      <FlowBridgeNested Include="$(TargetDir)$(AssemblyName)\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FlowBridgeNested)" DestinationFolder="..\..\App\bin\$(Configuration)\net10.0-windows\Plugins\$(AssemblyName)\" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PostPublish" AfterTargets="Publish">
    <ItemGroup>
      <FlowBridgePublishOutput Include="$(PublishDir)$(TargetName).dll" Condition="Exists('$(PublishDir)$(TargetName).dll')" />
      <FlowBridgePublishOutput Include="$(PublishDir)$(TargetName).pdb" Condition="Exists('$(PublishDir)$(TargetName).pdb')" />
      <FlowBridgePublishOutput Include="$(PublishDir)Flow.Launcher.Plugin.dll" Condition="Exists('$(PublishDir)Flow.Launcher.Plugin.dll')" />
      <FlowBridgePublishOutput Include="$(PublishDir)Flow.Launcher.Plugin.pdb" Condition="Exists('$(PublishDir)Flow.Launcher.Plugin.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(FlowBridgePublishOutput)" DestinationFolder="$(PublishDir)$(AssemblyName)\" SkipUnchangedFiles="true" />
    <Delete Files="@(FlowBridgePublishOutput)" Condition="$([System.IO.Path]::IsPathRooted('$(PublishDir)'))" />
  </Target>

</Project>
