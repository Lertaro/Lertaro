<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Lertaro.Core.Tests</AssemblyName>
    <RootNamespace>Lertaro.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj" />
    <None Include="..\..\portable-updater.ps1" Link="portable-updater.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\portable-updater.bat" Link="portable-updater.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- An empty Data folder beside the test assembly makes testhost a portable copy (DataDirectoryResolver), so
       Logger.SharedDataDir and the index cache directory resolve under bin rather than %ProgramData%\Lertaro.
       That directory belongs to an installed service, and a non-elevated test run may not read it. -->
  <Target Name="CreatePortableDataDirectory" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)Data" />
  </Target>

</Project>
